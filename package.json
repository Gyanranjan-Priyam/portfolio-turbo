{
  "name": "resume-portfolio-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --ui=tui",
    "dev:stream": "turbo run dev --ui=stream",
    "dev:web": "turbo run dev --filter=portfolio",
    "dev:blog": "turbo run dev --filter=blog",
    "dev:cms": "turbo run dev --filter=cms",
    "dev:apps": "turbo run dev --filter=portfolio --filter=blog",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "turbo": "^2.10.12",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14"
}
