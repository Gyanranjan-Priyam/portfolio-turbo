---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import SearchModal from '../components/SearchModal.astro';
import HatchDivider from '../components/HatchDivider.astro';
import type { MarkdownHeading } from 'astro';
import '../styles/post.css';

import placeholder2 from '../assets/blog-placeholder-2.jpg';
import placeholder3 from '../assets/blog-placeholder-3.jpg';
import placeholder4 from '../assets/blog-placeholder-4.jpg';
import placeholder5 from '../assets/blog-placeholder-5.jpg';

const placeholders = [placeholder2, placeholder3, placeholder4, placeholder5];

const getPlaceholderImage = (id: string) => {
  let hash = 0;
  for (let i = 0; i < id.length; i++) {
    hash = (hash << 5) - hash + id.charCodeAt(i);
    hash |= 0;
  }
  return placeholders[Math.abs(hash) % placeholders.length].src;
};

interface Props {
  data: CollectionEntry<'blog'>['data'];
  currentPostId?: string;
  headings?: MarkdownHeading[];
  nextPosts?: CollectionEntry<'blog'>[];
  allPosts?: CollectionEntry<'blog'>[];
}

const {
  data,
  currentPostId = '',
  headings = [],
  nextPosts = [],
  allPosts: rawAllPosts,
} = Astro.props;

const allPosts =
  rawAllPosts && rawAllPosts.length > 0
    ? rawAllPosts
    : (await getCollection('blog')).sort(
        (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
      );

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  tags = [],
  readingTime = '5 min read'
} = data;

const currentUrl = Astro.url.toString();
const encodedTitle = encodeURIComponent(title);
const encodedUrl = encodeURIComponent(currentUrl);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={heroImage}
      article={true}
      pubDate={pubDate}
      updatedDate={updatedDate}
      tags={tags}
      author={data.author}
      category={data.category}
    />
  </head>

  <body>
    <!-- Mobile-Only Sticky Header (< 1024px) -->
    <header class="mobile-post-header" aria-label="Mobile Navigation">
      <div class="mobile-header-inner">
        <a href="/" class="mobile-header-brand" aria-label="Back to Home">
          <img src="/logo.png" alt="Logo" class="mobile-brand-logo" width="28" height="28" />
          <span class="mobile-brand-title">Priyam's Blog</span>
        </a>

        <div class="mobile-header-actions">
          <ThemeToggle />
          <!-- TOC Trigger Button with live progress indicator -->
          {headings.length > 0 && (
            <button
              id="mobile-toc-trigger"
              class="mobile-toc-btn"
              aria-label="Table of Contents"
              title="Table of Contents & Reading Progress"
            >
              <span id="mobile-progress-badge" class="mobile-progress-badge">0%</span>
              <svg class="hamburger-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="4" x2="20" y1="6" y2="6"/>
                <line x1="4" x2="20" y1="12" y2="12"/>
                <line x1="4" x2="20" y1="18" y2="18"/>
              </svg>
            </button>
          )}
        </div>
      </div>

      <!-- Top Reading Progress Fill Bar -->
      <div class="mobile-scroll-track">
        <div id="mobile-scroll-progress-fill" class="mobile-scroll-fill"></div>
      </div>
    </header>

    <!-- Mobile TOC Drawer Overlay -->
    {headings.length > 0 && (
      <div id="mobile-toc-overlay" class="mobile-toc-overlay" aria-hidden="true">
        <div class="mobile-toc-backdrop" id="mobile-toc-backdrop"></div>
        <div class="mobile-toc-drawer" id="mobile-toc-drawer" role="dialog" aria-modal="true" aria-label="Table of Contents">
          <div class="mobile-drawer-drag-pill" aria-hidden="true"></div>
          <div class="mobile-drawer-header">
            <div class="mobile-drawer-title-box">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
              </svg>
              <span class="mobile-drawer-title">ON THIS PAGE</span>
            </div>
            <div class="mobile-drawer-right-meta">
              <span id="mobile-drawer-pct-text" class="mobile-drawer-pct-badge">0% read</span>
              <button id="mobile-toc-close-btn" class="mobile-drawer-close" aria-label="Close Table of Contents">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
            </div>
          </div>

          <!-- Drawer Progress Bar -->
          <div class="mobile-drawer-track">
            <div id="mobile-drawer-progress-fill" class="mobile-drawer-fill"></div>
          </div>

          <!-- TOC List in Drawer -->
          <div class="mobile-drawer-body">
            <ul class="mobile-toc-list">
              {headings.filter((h) => h.depth >= 1 && h.depth <= 3).map((heading) => (
                <li class={`mobile-toc-item depth-${heading.depth}`} data-heading-id={heading.slug}>
                  <a href={`#${heading.slug}`} class="mobile-toc-link">
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Drawer Footer with Quick Top Button -->
          <div class="mobile-drawer-footer">
            <button id="mobile-toc-top-btn" class="mobile-drawer-top-btn">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m18 15-6-6-6 6"/>
              </svg>
              <span>Back to top</span>
            </button>
          </div>
        </div>
      </div>
    )}

    <main class="post-layout-main">
      <div class="post-layout-container border-dotted-side">
        <div style="flex: 1; display: flex; flex-direction: column; width: 100%;">
        
        <!-- Top Minimal Nav -->
        <div class="post-top-nav-bar">
          <a href="/" class="post-top-brand" aria-label="Priyam's Blog Home">
            <img src="/logo.png" alt="Logo" class="post-top-logo" width="26" height="26" />
            <span class="post-top-brand-name">Priyam's Blog</span>
          </a>
          <div class="post-top-actions">
            <ThemeToggle />
          </div>
        </div>

        <!-- Hatch Pattern Separator below Top Nav -->
        <HatchDivider class="post-top-separator" />

        <!-- Centered Article Hero Header -->
        <header class="article-hero-header">
          <h1 class="article-hero-title">{title}</h1>

          <!-- Hero Cover Thumbnail Image (Between Title & Description) -->
          {heroImage ? (
            <div class="article-thumbnail-box">
              <img
                src={typeof heroImage === 'string' ? heroImage : heroImage.src}
                alt={title}
                class="article-thumbnail-img"
                loading="eager"
              />
            </div>
          ) : (
            <div class="article-thumbnail-box">
              <div class="post-cover-fallback">
                <img src={getPlaceholderImage(currentPostId || title)} alt="" class="fallback-backdrop" aria-hidden="true" />
                <div class="fallback-overlay"></div>
                <div class="fallback-content">
                  <div class="fallback-badge">
                    <span class="fallback-badge-icon">✦</span>
                    <span>{data.category || 'BLOG'}</span>
                  </div>
                  <h2 class="fallback-title">{title}</h2>
                  {description && (
                    <p class="fallback-subtitle">{description}</p>
                  )}
                </div>
              </div>
            </div>
          )}

          {description && (
            <p class="article-hero-desc">{description}</p>
          )}

          <div class="article-hero-meta">
            <span class="meta-item-author">{data.author || 'Gyanranjan Priyam'}</span>
            <span class="meta-bullet">•</span>
            <span class="meta-item-date"><FormattedDate date={pubDate} /></span>
            {data.category && (
              <>
                <span class="meta-bullet">•</span>
                <span class="meta-item-cat">{data.category}</span>
              </>
            )}
            {readingTime && (
              <>
                <span class="meta-bullet">•</span>
                <span class="meta-item-time">{readingTime}</span>
              </>
            )}
          </div>

          <!-- Copy Link Action Pill -->
          <div class="article-hero-actions">
            <button id="hero-copy-link-btn" class="hero-copy-pill" type="button" aria-label="Copy link to clipboard">
              <svg class="copy-icon" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
              </svg>
              <span>COPY LINK</span>
              <span id="hero-copy-toast" class="hero-toast">Copied!</span>
            </button>
          </div>
        </header>

        <!-- Hatch Pattern Divider Line -->
        <HatchDivider class="article-hero-divider" />

        <!-- 2-Column Responsive Layout (Article + Sticky TOC) -->
        <div class="post-layout-grid">
          <!-- Main Article Column -->
          <article class="post-article">

            <!-- Markdown Prose Body -->
            <div class="prose article-prose">
              <slot />
            </div>

            <!-- Article Bottom Tags & Share -->
            <div class="article-bottom-bar">
              {tags.length > 0 && (
                <div class="article-bottom-tags">
                  {tags.map((tag) => (
                    <a href={`/tags/${encodeURIComponent(tag)}`} class="bottom-tag-chip">
                      #{tag}
                    </a>
                  ))}
                </div>
              )}

              <div class="article-bottom-share">
                <span class="share-title">Share:</span>
                <a
                  href={`https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="meta-share-btn"
                  title="Share on X"
                  aria-label="Share on X"
                >
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                </a>
                <a
                  href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="meta-share-btn"
                  title="Share on LinkedIn"
                  aria-label="Share on LinkedIn"
                >
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76c.92 0 1.66-.74 1.66-1.66 0-.91-.74-1.66-1.66-1.66-.92 0-1.66.75-1.66 1.66 0 .92.74 1.66 1.66 1.66m1.39 9.74v-8.37H5.07v8.37h2.78z"/></svg>
                </a>
              </div>
            </div>

            <!-- Next Posts Section at End of Blog -->
            {nextPosts.length > 0 && (
              <div class="next-posts-end-section">
                <div class="next-posts-end-header">
                  <h3 class="next-posts-end-title">Next Posts</h3>
                  <span class="next-posts-end-sub">Continue reading</span>
                </div>
                <div class="next-posts-end-grid">
                  {nextPosts.slice(0, 2).map((post) => (
                    <a href={`/${post.id}`} class="next-post-end-card">
                      <h4 class="next-post-card-title">{post.data.title}</h4>
                      <p class="next-post-card-desc">{post.data.description}</p>
                      <div class="next-post-card-meta">
                        <span class="next-post-card-date">
                          <FormattedDate date={post.data.pubDate} />
                        </span>
                        {post.data.tags && post.data.tags.length > 0 && (
                          <span class="tag-pill-mini">#{post.data.tags[0]}</span>
                        )}
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            )}
          </article>

          <!-- Right Column: Table of Contents (Sticky on Desktop) -->
          <aside class="post-sidebar">
            <div class="sidebar-sticky-inner">
              {headings.length > 0 && (
                <TableOfContents headings={headings} />
              )}
            </div>
          </aside>
        </div>
        </div>

        <!-- Dotted Separator before Footer -->
        <div class="separator-dotted-h"></div>
        <Footer />
      </div>
    </main>

    <SearchModal posts={allPosts} />

    <script is:inline>
      // Copy link handlers
      const heroCopyBtn = document.getElementById('hero-copy-link-btn');
      const heroToast = document.getElementById('hero-copy-toast');

      if (heroCopyBtn && heroToast) {
        heroCopyBtn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(window.location.href);
            heroToast.classList.add('show');
            setTimeout(() => heroToast.classList.remove('show'), 2000);
          } catch (err) {
            console.error('Failed to copy', err);
          }
        });
      }

      // Mobile Header Reading Progress & TOC Drawer
      (function initMobileNav() {
        const trigger = document.getElementById('mobile-toc-trigger');
        const overlay = document.getElementById('mobile-toc-overlay');
        const backdrop = document.getElementById('mobile-toc-backdrop');
        const closeBtn = document.getElementById('mobile-toc-close-btn');
        const topBtn = document.getElementById('mobile-toc-top-btn');
        const progressFill = document.getElementById('mobile-scroll-progress-fill');
        const progressBadge = document.getElementById('mobile-progress-badge');
        const drawerFill = document.getElementById('mobile-drawer-progress-fill');
        const drawerPct = document.getElementById('mobile-drawer-pct-text');
        const tocLinks = document.querySelectorAll('.mobile-toc-link');
        const tocItems = document.querySelectorAll('.mobile-toc-item');

        function openDrawer() {
          if (overlay) {
            overlay.classList.add('open');
            overlay.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
          }
        }

        function closeDrawer() {
          if (overlay) {
            overlay.classList.remove('open');
            overlay.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
          }
        }

        if (trigger) trigger.addEventListener('click', openDrawer);
        if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
        if (backdrop) backdrop.addEventListener('click', closeDrawer);

        // Close on Escape key
        window.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && overlay && overlay.classList.contains('open')) {
            closeDrawer();
          }
        });

        if (topBtn) {
          topBtn.addEventListener('click', () => {
            closeDrawer();
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        }

        tocLinks.forEach((link) => {
          link.addEventListener('click', () => {
            closeDrawer();
          });
        });

        // Reading progress & active heading spy
        function updateProgress() {
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          if (docHeight <= 0) return;

          const progress = Math.min(100, Math.max(0, Math.round((window.scrollY / docHeight) * 100)));
          const pctStr = `${progress}%`;

          if (progressFill) progressFill.style.width = pctStr;
          if (progressBadge) progressBadge.textContent = pctStr;
          if (drawerFill) drawerFill.style.width = pctStr;
          if (drawerPct) drawerPct.textContent = `${progress}% read`;

          // Highlight active heading in mobile drawer
          const scrollPos = window.scrollY + 140;
          let activeHeadingId = '';

          tocItems.forEach((item) => {
            const hId = item.getAttribute('data-heading-id');
            const hEl = hId ? document.getElementById(hId) : null;
            if (hEl && hEl.offsetTop <= scrollPos) {
              activeHeadingId = hId;
            }
          });

          tocItems.forEach((item) => {
            const link = item.querySelector('.mobile-toc-link');
            const hId = item.getAttribute('data-heading-id');
            if (link) {
              if (hId === activeHeadingId) {
                link.classList.add('active');
              } else {
                link.classList.remove('active');
              }
            }
          });
        }

        window.addEventListener('scroll', updateProgress, { passive: true });
        updateProgress();
      })();
    </script>
  </body>
</html>
