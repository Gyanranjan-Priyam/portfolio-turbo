---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import SearchModal from '../components/SearchModal.astro';
import HatchDivider from '../components/HatchDivider.astro';
import type { MarkdownHeading } from 'astro';

import placeholder2 from '../assets/blog-placeholder-2.jpg';
import placeholder3 from '../assets/blog-placeholder-3.jpg';
import placeholder4 from '../assets/blog-placeholder-4.jpg';
import placeholder5 from '../assets/blog-placeholder-5.jpg';

const placeholders = [placeholder2, placeholder3, placeholder4, placeholder5];

const getPlaceholderImage = (id: string) => {
  let hash = 0;
  for (let i = 0; i < id.length; i++) {
    hash = (hash << 5) - hash + id.charCodeAt(i);
    hash |= 0;
  }
  return placeholders[Math.abs(hash) % placeholders.length].src;
};

interface Props {
  data: CollectionEntry<'blog'>['data'];
  currentPostId?: string;
  headings?: MarkdownHeading[];
  nextPosts?: CollectionEntry<'blog'>[];
  allPosts?: CollectionEntry<'blog'>[];
}

const {
  data,
  currentPostId = '',
  headings = [],
  nextPosts = [],
  allPosts: rawAllPosts,
} = Astro.props;

const allPosts =
  rawAllPosts && rawAllPosts.length > 0
    ? rawAllPosts
    : (await getCollection('blog')).sort(
        (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
      );

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  tags = [],
  readingTime = '5 min read'
} = data;

const currentUrl = Astro.url.toString();
const encodedTitle = encodeURIComponent(title);
const encodedUrl = encodeURIComponent(currentUrl);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={heroImage}
      article={true}
      pubDate={pubDate}
      updatedDate={updatedDate}
      tags={tags}
      author={data.author}
      category={data.category}
    />
  </head>

  <body class="bg-[var(--bg-primary)] text-[var(--text-primary)] min-h-screen flex flex-col font-sans">
    <!-- Mobile-Only Sticky Header (< 1024px) -->
    <header class="lg:hidden block sticky top-0 z-40 w-full bg-[var(--bg-glass)] backdrop-blur-xl border-b border-[var(--border-subtle)]" aria-label="Mobile Navigation">
      <div class="w-full px-4 py-2.5 flex items-center justify-between gap-3">
        <a href="/" class="flex items-center gap-2 text-inherit no-underline min-w-0" aria-label="Back to Home">
          <img src="/logo.png" alt="Logo" class="w-7 h-7 object-contain shrink-0" width="28" height="28" />
          <span class="font-display font-bold text-base tracking-tight text-[var(--text-primary)] truncate">Priyam's Blog</span>
        </a>

        <div class="flex items-center gap-2 shrink-0">
          <ThemeToggle />
          <!-- TOC Trigger Button with live progress indicator -->
          {headings.length > 0 && (
            <button
              id="mobile-toc-trigger"
              class="inline-flex items-center gap-2 bg-[var(--bg-tag)] hover:bg-[var(--bg-tag-hover)] border border-[var(--border-subtle)] hover:border-[var(--border-glow)] rounded-full px-2.5 py-1 h-[30px] text-[var(--text-secondary)] hover:text-[var(--text-primary)] cursor-pointer transition-all duration-150"
              aria-label="Table of Contents"
              title="Table of Contents & Reading Progress"
            >
              <span id="mobile-progress-badge" class="font-mono text-xs font-semibold text-amber-800 dark:text-yellow-300">0%</span>
              <svg class="shrink-0" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="4" x2="20" y1="6" y2="6"/>
                <line x1="4" x2="20" y1="12" y2="12"/>
                <line x1="4" x2="20" y1="18" y2="18"/>
              </svg>
            </button>
          )}
        </div>
      </div>

      <!-- Top Reading Progress Fill Bar -->
      <div class="w-full h-[2.5px] bg-transparent relative overflow-hidden">
        <div id="mobile-scroll-progress-fill" class="h-full w-0 bg-amber-600 dark:bg-yellow-400 transition-[width] duration-75"></div>
      </div>
    </header>

    <!-- Mobile TOC Drawer Overlay -->
    {headings.length > 0 && (
      <div id="mobile-toc-overlay" class="fixed inset-0 z-50 invisible pointer-events-none transition-[visibility] duration-200 [&.open]:visible [&.open]:pointer-events-auto" aria-hidden="true">
        <div class="absolute inset-0 bg-black/60 backdrop-blur-md opacity-0 transition-opacity duration-200" id="mobile-toc-backdrop"></div>
        <div class="absolute bottom-0 left-0 right-0 max-h-[82vh] bg-[var(--bg-card)] border-t border-[var(--border-glow)] rounded-t-[20px] shadow-[0_-10px_40px_rgba(0,0,0,0.45)] flex flex-col translate-y-full transition-transform duration-300" id="mobile-toc-drawer" role="dialog" aria-modal="true" aria-label="Table of Contents">
          <div class="w-9 h-1 rounded-full bg-[var(--border-subtle)] mx-auto mt-3 opacity-80" aria-hidden="true"></div>
          <div class="flex items-center justify-between px-5 py-3.5">
            <div class="flex items-center gap-2 text-[var(--text-muted)]">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
              </svg>
              <span class="font-mono text-xs font-semibold tracking-wider">ON THIS PAGE</span>
            </div>
            <div class="flex items-center gap-3">
              <span id="mobile-drawer-pct-text" class="font-mono text-xs font-semibold text-amber-800 dark:text-yellow-300">0% read</span>
              <button id="mobile-toc-close-btn" class="bg-[var(--bg-tag)] hover:bg-[var(--bg-tag-hover)] border border-[var(--border-subtle)] hover:border-[var(--border-glow)] rounded-full w-7 h-7 flex items-center justify-center text-[var(--text-secondary)] hover:text-[var(--text-primary)] cursor-pointer transition-all duration-150" aria-label="Close Table of Contents">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
            </div>
          </div>

          <!-- Drawer Progress Bar -->
          <div class="w-full h-[3px] bg-[var(--bg-tag)]">
            <div id="mobile-drawer-progress-fill" class="h-full w-0 bg-amber-600 dark:bg-yellow-400 transition-[width] duration-75"></div>
          </div>

          <!-- TOC List in Drawer -->
          <div class="flex-1 overflow-y-auto px-5 py-4 max-h-[calc(82vh-130px)] scrollbar-thin">
            <ul class="list-none m-0 p-0 flex flex-col gap-1.5">
              {headings.filter((h) => h.depth >= 1 && h.depth <= 3).map((heading) => (
                <li class={`mobile-toc-item ${heading.depth >= 3 ? 'text-xs pl-4' : 'text-sm font-medium'}`} data-heading-id={heading.slug}>
                  <a href={`#${heading.slug}`} class="mobile-toc-link block text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-tag-hover)] no-underline px-2.5 py-1.5 rounded-md transition-all duration-150">
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Drawer Footer with Quick Top Button -->
          <div class="px-5 py-3 pb-5 border-t border-[var(--border-subtle)] flex justify-center">
            <button id="mobile-toc-top-btn" class="inline-flex items-center gap-1.5 bg-[var(--bg-tag)] hover:bg-[var(--bg-tag-hover)] border border-[var(--border-subtle)] hover:border-[var(--border-glow)] rounded-full px-4 py-1.5 text-[var(--text-secondary)] hover:text-[var(--text-primary)] font-mono text-xs cursor-pointer transition-all duration-150">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m18 15-6-6-6 6"/>
              </svg>
              <span>Back to top</span>
            </button>
          </div>
        </div>
      </div>
    )}

    <main class="w-full min-h-screen p-0 bg-[var(--bg-primary)] flex flex-col">
      <div class="w-full max-w-[1140px] mx-auto px-5 sm:px-9 pt-8 pb-16 min-h-screen flex flex-col border-dotted-side">
        <div class="flex-1 flex flex-col w-full">
        
        <!-- Top Minimal Nav -->
        <div class="hidden lg:flex items-center justify-between pb-2 w-full">
          <a href="/" class="group inline-flex items-center gap-2 text-inherit no-underline text-[var(--text-primary)]" aria-label="Priyam's Blog Home">
            <img src="/logo.png" alt="Logo" class="w-6.5 h-6.5 object-contain group-hover:scale-105 transition-transform duration-200" width="26" height="26" />
            <span class="font-display text-[0.95rem] font-bold text-[var(--text-primary)]">Priyam's Blog</span>
          </a>
          <div class="flex items-center gap-2">
            <ThemeToggle />
          </div>
        </div>

        <!-- Hatch Pattern Separator below Top Nav -->
        <HatchDivider class="hidden lg:block !mt-0 !mb-7" />

        <!-- Centered Article Hero Header -->
        <header class="flex flex-col items-center text-center max-w-[860px] mx-auto mb-6 px-2">
          <h1 class="font-display text-2xl sm:text-3xl md:text-4xl lg:text-[2.35rem] font-bold leading-tight tracking-tight text-[var(--text-primary)] mx-auto mb-5 text-center max-w-[800px]">{title}</h1>

          <!-- Hero Cover Thumbnail Image (Between Title & Description) -->
          {heroImage ? (
            <div class="w-full max-w-[800px] rounded-[var(--radius-md)] overflow-hidden border border-[var(--border-subtle)] shadow-[var(--shadow-sm)] mx-auto mb-5">
              <img
                src={typeof heroImage === 'string' ? heroImage : heroImage.src}
                alt={title}
                class="w-full h-auto block"
                loading="eager"
              />
            </div>
          ) : (
            <div class="w-full max-w-[800px] rounded-[var(--radius-md)] overflow-hidden border border-[var(--border-subtle)] shadow-[var(--shadow-sm)] mx-auto mb-5">
              <div class="relative w-full aspect-video flex flex-col items-center justify-center p-5 overflow-hidden text-center bg-[#0c0d12]">
                <img src={getPlaceholderImage(currentPostId || title)} alt="" class="absolute inset-0 w-full h-full object-cover z-1 opacity-90 brightness-85 contrast-110" aria-hidden="true" />
                <div class="absolute inset-0 z-2 pointer-events-none bg-[radial-gradient(circle_at_center,rgba(12,13,18,0.45)_0%,rgba(8,8,12,0.88)_100%)]"></div>
                <div class="relative z-3 flex flex-col items-center justify-center gap-1.5 max-w-[90%]">
                  <div class="inline-flex items-center gap-1.5 font-mono text-[0.62rem] font-bold tracking-[0.14em] uppercase text-white/85 drop-shadow-md">
                    <span class="text-[0.7rem] text-yellow-300">✦</span>
                    <span>{data.category || 'BLOG'}</span>
                  </div>
                  <h2 class="font-serif text-lg sm:text-xl font-semibold leading-snug text-white tracking-tight line-clamp-2 drop-shadow-lg m-0">{title}</h2>
                  {description && (
                    <p class="font-sans text-[0.72rem] text-white/70 line-clamp-1 max-w-[90%] m-0 drop-shadow">{description}</p>
                  )}
                </div>
              </div>
            </div>
          )}

          {description && (
            <p class="font-sans text-sm sm:text-base leading-relaxed text-[var(--text-secondary)] max-w-[680px] mx-auto mb-5 text-center">{description}</p>
          )}

          <div class="flex items-center justify-center flex-wrap gap-2 font-mono text-xs font-semibold tracking-wider uppercase text-[var(--text-muted)] mb-4">
            <span>{data.author || 'Gyanranjan Priyam'}</span>
            <span class="opacity-40">•</span>
            <span><FormattedDate date={pubDate} /></span>
            {data.category && (
              <>
                <span class="opacity-40">•</span>
                <span>{data.category}</span>
              </>
            )}
            {readingTime && (
              <>
                <span class="opacity-40">•</span>
                <span>{readingTime}</span>
              </>
            )}
          </div>

          <!-- Copy Link Action Pill -->
          <div class="flex justify-center relative mb-2">
            <button id="hero-copy-link-btn" class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[var(--bg-card)] hover:bg-[var(--bg-card-hover)] border border-[var(--border-subtle)] hover:border-[var(--border-glow)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] font-mono text-[0.72rem] font-semibold tracking-wide cursor-pointer transition-all duration-200 relative" type="button" aria-label="Copy link to clipboard">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
              </svg>
              <span>COPY LINK</span>
              <span id="hero-copy-toast" class="absolute -top-7 left-1/2 -translate-x-1/2 bg-[var(--text-primary)] text-[var(--text-inverted)] font-mono text-[0.68rem] font-semibold px-2 py-0.5 rounded pointer-events-none opacity-0 transition-opacity duration-200 whitespace-nowrap">Copied!</span>
            </button>
          </div>
        </header>

        <!-- Hatch Pattern Divider Line -->
        <HatchDivider class="!mt-0 !mb-10" />

        <!-- 2-Column Responsive Layout (Article + Sticky TOC) -->
        <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,760px)_260px] lg:justify-center gap-10 lg:gap-14 items-start w-full">
          <!-- Main Article Column -->
          <article class="min-w-0 w-full max-w-[760px] mx-auto">

            <!-- Markdown Prose Body -->
            <div class="prose w-full">
              <slot />
            </div>

            <!-- Article Bottom Tags & Share -->
            <div class="flex items-center justify-between flex-wrap gap-4 pt-7 mt-12 relative before:content-[''] before:absolute before:top-0 before:left-0 before:right-0 before:h-[2.5px] before:bg-[radial-gradient(circle,var(--dotted-border)_1.25px,transparent_1.25px)] before:bg-[length:10px_2.5px] before:bg-repeat-x before:bg-center">
              {tags.length > 0 && (
                <div class="flex flex-wrap gap-1.5">
                  {tags.map((tag) => (
                    <a href={`/tags/${encodeURIComponent(tag)}`} class="font-mono text-xs font-medium text-[var(--text-secondary)] hover:text-[var(--text-primary)] bg-[var(--bg-tag)] hover:bg-[var(--bg-tag-hover)] border border-[var(--border-subtle)] hover:border-[var(--border-glow)] px-2.5 py-0.5 rounded no-underline transition-all duration-150">
                      #{tag}
                    </a>
                  ))}
                </div>
              )}

              <div class="flex items-center gap-2">
                <span class="font-mono text-xs text-[var(--text-muted)]">Share:</span>
                <a
                  href={`https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center w-7.5 h-7.5 rounded-full bg-[var(--bg-tag)] hover:bg-[var(--bg-tag-hover)] border border-[var(--border-subtle)] hover:border-[var(--border-glow)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-all duration-150 no-underline"
                  title="Share on X"
                  aria-label="Share on X"
                >
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                </a>
                <a
                  href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center w-7.5 h-7.5 rounded-full bg-[var(--bg-tag)] hover:bg-[var(--bg-tag-hover)] border border-[var(--border-subtle)] hover:border-[var(--border-glow)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-all duration-150 no-underline"
                  title="Share on LinkedIn"
                  aria-label="Share on LinkedIn"
                >
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76c.92 0 1.66-.74 1.66-1.66 0-.91-.74-1.66-1.66-1.66-.92 0-1.66.75-1.66 1.66 0 .92.74 1.66 1.66 1.66m1.39 9.74v-8.37H5.07v8.37h2.78z"/></svg>
                </a>
              </div>
            </div>

            <!-- Next Posts Section at End of Blog -->
            {nextPosts.length > 0 && (
              <div class="mt-16 pt-8 relative before:content-[''] before:absolute before:top-0 before:left-0 before:right-0 before:h-[2.5px] before:bg-[radial-gradient(circle,var(--dotted-border)_1.25px,transparent_1.25px)] before:bg-[length:10px_2.5px] before:bg-repeat-x before:bg-center">
                <div class="flex items-baseline justify-between mb-6">
                  <h3 class="text-xl font-bold text-[var(--text-primary)] m-0">Next Posts</h3>
                  <span class="font-mono text-xs text-[var(--text-muted)]">Continue reading</span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                  {nextPosts.slice(0, 2).map((post) => (
                    <a href={`/${post.id}`} class="flex flex-col justify-between no-underline bg-[var(--bg-card)] hover:bg-[var(--bg-card-hover)] border border-[var(--border-subtle)] hover:border-[var(--border-glow)] rounded-xl p-5 shadow-[var(--shadow-sm)] hover:-translate-y-0.5 transition-all duration-150">
                      <h4 class="text-[0.95rem] font-semibold leading-snug text-[var(--text-primary)] mb-2 line-clamp-2">{post.data.title}</h4>
                      <p class="font-mono text-xs leading-relaxed text-[var(--text-secondary)] mb-4 line-clamp-2">{post.data.description}</p>
                      <div class="flex items-center justify-between mt-auto">
                        <span class="font-mono text-xs text-[var(--text-muted)]">
                          <FormattedDate date={post.data.pubDate} />
                        </span>
                        {post.data.tags && post.data.tags.length > 0 && (
                          <span class="font-mono text-[0.68rem] font-medium text-[var(--text-secondary)] bg-[var(--bg-tag)] border border-[var(--border-subtle)] rounded px-1.5 py-0.5">#{post.data.tags[0]}</span>
                        )}
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            )}
          </article>

          <!-- Right Column: Table of Contents (Sticky on Desktop) -->
          <aside class="hidden lg:block sticky top-8 max-w-[260px] justify-self-end w-full">
            <div class="flex flex-col gap-6 w-full">
              {headings.length > 0 && (
                <TableOfContents headings={headings} />
              )}
            </div>
          </aside>
        </div>
        </div>

        <!-- Dotted Separator before Footer -->
        <div class="separator-dotted-h"></div>
        <Footer />
      </div>
    </main>

    <SearchModal posts={allPosts} />

    <script is:inline>
      const heroCopyBtn = document.getElementById('hero-copy-link-btn');
      const heroToast = document.getElementById('hero-copy-toast');

      if (heroCopyBtn && heroToast) {
        heroCopyBtn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(window.location.href);
            heroToast.style.opacity = '1';
            setTimeout(() => { heroToast.style.opacity = '0'; }, 2000);
          } catch (err) {
            console.error('Failed to copy', err);
          }
        });
      }

      (function initMobileNav() {
        const trigger = document.getElementById('mobile-toc-trigger');
        const overlay = document.getElementById('mobile-toc-overlay');
        const backdrop = document.getElementById('mobile-toc-backdrop');
        const drawer = document.getElementById('mobile-toc-drawer');
        const closeBtn = document.getElementById('mobile-toc-close-btn');
        const topBtn = document.getElementById('mobile-toc-top-btn');
        const progressFill = document.getElementById('mobile-scroll-progress-fill');
        const progressBadge = document.getElementById('mobile-progress-badge');
        const drawerFill = document.getElementById('mobile-drawer-progress-fill');
        const drawerPct = document.getElementById('mobile-drawer-pct-text');
        const tocLinks = document.querySelectorAll('.mobile-toc-link');
        const tocItems = document.querySelectorAll('.mobile-toc-item');

        function openDrawer() {
          if (overlay && backdrop && drawer) {
            overlay.classList.add('open');
            backdrop.style.opacity = '1';
            drawer.style.transform = 'translate3d(0, 0, 0)';
            overlay.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
          }
        }

        function closeDrawer() {
          if (overlay && backdrop && drawer) {
            backdrop.style.opacity = '0';
            drawer.style.transform = 'translate3d(0, 100%, 0)';
            setTimeout(() => {
              overlay.classList.remove('open');
              overlay.setAttribute('aria-hidden', 'true');
            }, 200);
            document.body.style.overflow = '';
          }
        }

        if (trigger) trigger.addEventListener('click', openDrawer);
        if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
        if (backdrop) backdrop.addEventListener('click', closeDrawer);

        window.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && overlay && overlay.classList.contains('open')) {
            closeDrawer();
          }
        });

        if (topBtn) {
          topBtn.addEventListener('click', () => {
            closeDrawer();
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        }

        tocLinks.forEach((link) => {
          link.addEventListener('click', () => {
            closeDrawer();
          });
        });

        const activeDrawerClasses = ['!text-amber-700', 'dark:!text-yellow-300', '!font-semibold', 'bg-amber-500/15', 'dark:bg-yellow-400/10'];

        function updateProgress() {
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          if (docHeight <= 0) return;

          const progress = Math.min(100, Math.max(0, Math.round((window.scrollY / docHeight) * 100)));
          const pctStr = `${progress}%`;

          if (progressFill) progressFill.style.width = pctStr;
          if (progressBadge) progressBadge.textContent = pctStr;
          if (drawerFill) drawerFill.style.width = pctStr;
          if (drawerPct) drawerPct.textContent = `${progress}% read`;

          const scrollPos = window.scrollY + 140;
          let activeHeadingId = '';

          tocItems.forEach((item) => {
            const hId = item.getAttribute('data-heading-id');
            const hEl = hId ? document.getElementById(hId) : null;
            if (hEl && hEl.offsetTop <= scrollPos) {
              activeHeadingId = hId;
            }
          });

          tocItems.forEach((item) => {
            const link = item.querySelector('.mobile-toc-link');
            const hId = item.getAttribute('data-heading-id');
            if (link) {
              if (hId === activeHeadingId) {
                link.classList.add(...activeDrawerClasses);
              } else {
                link.classList.remove(...activeDrawerClasses);
              }
            }
          });
        }

        window.addEventListener('scroll', updateProgress, { passive: true });
        updateProgress();
      })();
    </script>
  </body>
</html>
