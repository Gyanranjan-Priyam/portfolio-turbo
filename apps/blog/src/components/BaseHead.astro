---
import "../styles/global.css";
import type { ImageMetadata } from "astro";
import FallbackImage from "../assets/blog-placeholder-1.jpg";
import {
  SITE_TITLE,
  SITE_DESCRIPTION,
  SITE_URL,
  AUTHOR_NAME,
  AUTHOR_TWITTER,
  AUTHOR_PORTFOLIO,
  AUTHOR_GITHUB,
  GLOBAL_SEO_KEYWORDS,
} from "../consts";

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata | string;
  article?: boolean;
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  author?: string;
  category?: string;
  keywords?: string[];
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site || SITE_URL);

const {
  title,
  description,
  image = FallbackImage,
  article = false,
  pubDate,
  updatedDate,
  tags = [],
  author = AUTHOR_NAME,
  category,
  keywords = [],
} = Astro.props;

// Determine absolute OpenGraph image URL for every blog post
const imageSrc = typeof image === "string" ? image : image?.src;
let ogImage = "";
if (imageSrc) {
  if (imageSrc.startsWith("http://") || imageSrc.startsWith("https://")) {
    ogImage = imageSrc;
  } else {
    ogImage = new URL(imageSrc, Astro.site || SITE_URL).toString();
  }
} else {
  ogImage = new URL(
    "/android-chrome-512x512.png",
    Astro.site || SITE_URL,
  ).toString();
}

// Merge & deduplicate rich SEO keywords
const allKeywords = [
  ...tags,
  ...(category ? [category] : []),
  ...keywords,
  ...GLOBAL_SEO_KEYWORDS,
];
const combinedKeywords = [...new Set(allKeywords)].join(", ");

// Schema.org Structured Data
const structuredData = article
  ? {
      "@context": "https://schema.org",
      "@type": "TechArticle",
      headline: title,
      description: description,
      image: [ogImage],
      datePublished: pubDate ? pubDate.toISOString() : undefined,
      dateModified: (updatedDate || pubDate)?.toISOString(),
      author: {
        "@type": "Person",
        name: author || AUTHOR_NAME,
        url: AUTHOR_PORTFOLIO,
        sameAs: [
          AUTHOR_GITHUB,
          `https://x.com/${AUTHOR_TWITTER.replace("@", "")}`,
        ],
      },
      publisher: {
        "@type": "Organization",
        name: "Priyam's Blog",
        url: SITE_URL,
        logo: {
          "@type": "ImageObject",
          url: new URL("/logo.png", Astro.site || SITE_URL).toString(),
        },
      },
      mainEntityOfPage: {
        "@type": "WebPage",
        "@id": canonicalURL.toString(),
      },
      keywords: combinedKeywords,
      articleSection: category || "Technology",
    }
  : {
      "@context": "https://schema.org",
      "@type": "Blog",
      name: "Priyam's Blog",
      description: description || SITE_DESCRIPTION,
      url: canonicalURL.toString(),
      publisher: {
        "@type": "Organization",
        name: "Priyam's Blog",
        url: SITE_URL,
        logo: {
          "@type": "ImageObject",
          url: new URL("/logo.png", Astro.site || SITE_URL).toString(),
        },
      },
      author: {
        "@type": "Person",
        name: AUTHOR_NAME,
        url: AUTHOR_PORTFOLIO,
      },
    };
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<!-- Browser & Device Favicons / Title Tab Icons -->
<link rel="icon" type="image/png" href="/logo.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="shortcut icon" type="image/png" href="/logo.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="apple-touch-icon" href="/logo.png" />
<link rel="image_src" href="/logo.png" />
<meta name="msapplication-TileImage" content="/logo.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL("rss.xml", Astro.site || SITE_URL)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Search Engine Optimization Meta Tags -->
<title>{title ? `${title} | Priyam's Blog` : SITE_TITLE}</title>
<meta name="title" content={title ? `${title} | Priyam's Blog` : SITE_TITLE} />
<meta name="description" content={description || SITE_DESCRIPTION} />
<meta name="keywords" content={combinedKeywords} />
<meta name="author" content={author || AUTHOR_NAME} />
<meta
  name="robots"
  content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
/>
<meta name="googlebot" content="index, follow" />
<meta name="language" content="English" />
<meta name="revisit-after" content="2 days" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- PWA & Offline Manifest -->
<link rel="manifest" href="/site.webmanifest" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="theme-color" content="#090a0f" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta
  name="apple-mobile-web-app-status-bar-style"
  content="black-translucent"
/>

<!-- Open Graph / Facebook -->
<meta property="og:type" content={article ? "article" : "website"} />
<meta property="og:site_name" content="Priyam's Blog" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description || SITE_DESCRIPTION} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={title} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_US" />
{
  article && pubDate && (
    <meta property="article:published_time" content={pubDate.toISOString()} />
  )
}
{
  article && (updatedDate || pubDate) && (
    <meta
      property="article:modified_time"
      content={(updatedDate || pubDate).toISOString()}
    />
  )
}
{article && <meta property="article:author" content={author || AUTHOR_NAME} />}
{article && tags.map((t) => <meta property="article:tag" content={t} />)}

<!-- Twitter Card Tags -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={AUTHOR_TWITTER} />
<meta name="twitter:creator" content={AUTHOR_TWITTER} />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description || SITE_DESCRIPTION} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={title} />

<!-- JSON-LD Structured Data Schema -->
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

<!-- Theme Initialization & Service Worker Script -->
<script is:inline>
  // Theme setup
  const storedTheme = localStorage.getItem("theme");
  const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
  if (storedTheme === "dark" || (!storedTheme && prefersDark)) {
    document.documentElement.classList.add("dark");
  } else {
    document.documentElement.classList.remove("dark");
  }

  // Service Worker Registration for Offline Capabilities
  if ("serviceWorker" in navigator) {
    window.addEventListener("load", () => {
      navigator.serviceWorker
        .register("/sw.js")
        .then((reg) => {
          reg.addEventListener("updatefound", () => {
            const newWorker = reg.installing;
            if (newWorker) {
              newWorker.addEventListener("statechange", () => {
                if (
                  newWorker.state === "installed" &&
                  navigator.serviceWorker.controller
                ) {
                  console.log(
                    "[SW] New version available for offline browsing.",
                  );
                }
              });
            }
          });
        })
        .catch((err) => {
          console.warn("[SW] Registration failed:", err);
        });
    });
  }

  // Global Offline / Online Toast Banner
  (function initOfflineNotifier() {
    function createToast() {
      let toast = document.getElementById("global-offline-toast");
      if (toast) return toast;

      toast = document.createElement("div");
      toast.id = "global-offline-toast";
      toast.innerHTML = `
        <div class="toast-inner">
          <span class="toast-dot offline"></span>
          <span class="toast-text">Offline mode · Cached pages active</span>
          <a href="/offline" class="toast-game-btn" title="Play Byte Runner Offline Game">🕹️ Play Game</a>
        </div>
      `;
      document.body.appendChild(toast);
      return toast;
    }

    function showOfflineToast() {
      const toast = createToast();
      const dot = toast.querySelector(".toast-dot");
      const text = toast.querySelector(".toast-text");
      const gameBtn = toast.querySelector(".toast-game-btn");

      if (dot) {
        dot.className = "toast-dot offline";
      }
      if (text) {
        text.textContent = "Offline mode · Cached articles readable";
      }
      if (gameBtn) {
        gameBtn.style.display = "inline-flex";
      }
      toast.classList.add("visible");
    }

    function showOnlineToast() {
      const toast = document.getElementById("global-offline-toast");
      if (!toast) return;

      const dot = toast.querySelector(".toast-dot");
      const text = toast.querySelector(".toast-text");
      const gameBtn = toast.querySelector(".toast-game-btn");

      if (dot) {
        dot.className = "toast-dot online";
      }
      if (text) {
        text.textContent = "🟢 Back online! Syncing updates...";
      }
      if (gameBtn) {
        gameBtn.style.display = "none";
      }

      setTimeout(() => {
        toast.classList.remove("visible");
      }, 3500);
    }

    window.addEventListener("offline", showOfflineToast);
    window.addEventListener("online", showOnlineToast);

    // Initial check
    if (typeof navigator !== "undefined" && !navigator.onLine) {
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", showOfflineToast);
      } else {
        showOfflineToast();
      }
    }
  })();
</script>

<style is:global>
  #global-offline-toast {
    position: fixed;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%) translateY(100px);
    z-index: 9999;
    transition:
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.3s ease;
    opacity: 0;
    pointer-events: none;
  }

  #global-offline-toast.visible {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  #global-offline-toast .toast-inner {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.5rem 0.85rem;
    background: var(--bg-card, #18181b);
    border: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.15));
    border-radius: 9999px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    font-family: var(--font-mono, monospace);
    font-size: 0.76rem;
    color: var(--text-primary, #fff);
  }

  .toast-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .toast-dot.offline {
    background: #eab308;
    box-shadow: 0 0 8px #eab308;
    animation: toast-pulse 1.8s infinite;
  }

  .toast-dot.online {
    background: #22c55e;
    box-shadow: 0 0 8px #22c55e;
  }

  @keyframes toast-pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.4;
      transform: scale(0.85);
    }
  }

  .toast-game-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.6rem;
    background: var(--bg-tag, rgba(255, 255, 255, 0.08));
    border: 1px solid var(--border-glow, rgba(255, 255, 255, 0.2));
    border-radius: 9999px;
    color: var(--accent-primary, #60a5fa);
    text-decoration: none;
    font-weight: 600;
    transition: all 0.15s ease;
  }

  .toast-game-btn:hover {
    background: var(--accent-primary, #3b82f6);
    color: #fff;
    transform: scale(1.04);
  }
</style>
