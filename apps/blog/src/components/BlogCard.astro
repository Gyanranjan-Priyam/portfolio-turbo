import FormattedDate from './FormattedDate.astro';
import type { CollectionEntry } from 'astro:content';
import placeholder2 from '../assets/blog-placeholder-2.jpg';
import placeholder3 from '../assets/blog-placeholder-3.jpg';
import placeholder4 from '../assets/blog-placeholder-4.jpg';
import placeholder5 from '../assets/blog-placeholder-5.jpg';

const placeholders = [placeholder2, placeholder3, placeholder4, placeholder5];

const getPlaceholderImage = (id: string) => {
  let hash = 0;
  for (let i = 0; i < id.length; i++) {
    hash = (hash << 5) - hash + id.charCodeAt(i);
    hash |= 0;
  }
  return placeholders[Math.abs(hash) % placeholders.length].src;
};

interface Props {
  post: CollectionEntry<'blog'>;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const { title, description, pubDate, heroImage, tags = [], readingTime = '5 min read', category = 'Engineering' } = post.data;
---

<article class:list={['blog-card', 'glass-card', { 'blog-card-featured': featured }]}>
  <a href={`/${post.id}`} class="card-link">
    <div class="image-wrapper">
      {heroImage ? (
        <img
          src={typeof heroImage === 'string' ? heroImage : heroImage.src}
          alt={title}
          class="card-image"
          loading="lazy"
        />
      ) : (
        <div class="post-cover-fallback">
          <img src={getPlaceholderImage(post.id)} alt="" class="fallback-backdrop" aria-hidden="true" />
          <div class="fallback-overlay"></div>
          <div class="fallback-content">
            <div class="fallback-badge">
              <span class="fallback-badge-icon">✦</span>
              <span>{category || 'BLOG'}</span>
            </div>
            <h4 class="fallback-title">{title}</h4>
            {description && (
              <p class="fallback-subtitle">{description}</p>
            )}
          </div>
        </div>
      )}
    </div>

    <div class="card-content">
      <div class="card-meta">
        <span class="meta-item reading-time">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          {readingTime}
        </span>
        <span class="meta-separator">&bull;</span>
        <span class="meta-item date">
          <FormattedDate date={pubDate} />
        </span>
      </div>

      <h3 class="card-title">{title}</h3>
      <p class="card-description">{description}</p>

      <div class="card-footer">
        <div class="card-tags">
          {tags.slice(0, 3).map((tag) => (
            <span class="tag-pill">#{tag}</span>
          ))}
        </div>

        <span class="read-more">
          Read Article
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </span>
      </div>
    </div>
  </a>
</article>

<style>
  .blog-card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }


  .card-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .reading-time {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .card-title {
    font-size: 1.35rem;
    margin: 0 0 0.65rem;
    line-height: 1.35;
    color: var(--text-primary);
    transition: color 0.2s ease;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.7em;
  }

  .blog-card:hover .card-title {
    color: var(--accent-primary);
  }

  .card-description {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin: 0 0 1.25rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 3.1em;
  }

  .card-footer {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag-pill {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-primary);
    transition: transform 0.2s ease;
  }

  .blog-card:hover .read-more {
    transform: translateX(3px);
  }

  /* Featured Variation */
  .blog-card-featured {
    grid-column: 1 / -1;
  }

  @media (min-width: 840px) {
    .blog-card-featured .card-link {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
    }
    .blog-card-featured .image-wrapper {
      aspect-ratio: auto;
      height: 100%;
    }
    .blog-card-featured .card-content {
      padding: 2.5rem;
      justify-content: center;
    }
    .blog-card-featured .card-title {
      font-size: 1.85rem;
    }
    .blog-card-featured .card-description {
      -webkit-line-clamp: 4;
      font-size: 1.05rem;
    }
  }
</style>
