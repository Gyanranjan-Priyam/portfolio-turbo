---
import FormattedDate from './FormattedDate.astro';
import type { CollectionEntry } from 'astro:content';
import placeholder2 from '../assets/blog-placeholder-2.jpg';
import placeholder3 from '../assets/blog-placeholder-3.jpg';
import placeholder4 from '../assets/blog-placeholder-4.jpg';
import placeholder5 from '../assets/blog-placeholder-5.jpg';

const placeholders = [placeholder2, placeholder3, placeholder4, placeholder5];

const getPlaceholderImage = (id: string) => {
  let hash = 0;
  for (let i = 0; i < id.length; i++) {
    hash = (hash << 5) - hash + id.charCodeAt(i);
    hash |= 0;
  }
  return placeholders[Math.abs(hash) % placeholders.length].src;
};

interface Props {
  post: CollectionEntry<'blog'>;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const { title, description, pubDate, heroImage, tags = [], readingTime = '5 min read', category = 'Engineering' } = post.data;
---

<article class:list={[
  'group relative overflow-hidden flex flex-col h-full rounded-[var(--radius-md)] bg-[var(--bg-card)] border border-[var(--border-card)] shadow-[var(--shadow-sm)] hover:bg-[var(--bg-card-hover)] hover:border-[var(--border-glow)] transition-all duration-200',
  { 'col-span-full': featured }
]}>
  <a href={`/${post.id}`} class:list={[
    'flex flex-col h-full text-inherit no-underline',
    { 'min-[840px]:grid min-[840px]:grid-cols-[1.2fr_1fr]': featured }
  ]}>
    <div class:list={[
      'relative w-full aspect-video rounded-[var(--radius-md)] overflow-hidden border border-[var(--border-subtle)]',
      { 'min-[840px]:aspect-auto min-[840px]:h-full': featured }
    ]}>
      {heroImage ? (
        <img
          src={typeof heroImage === 'string' ? heroImage : heroImage.src}
          alt={title}
          class="w-full h-full object-cover object-center block"
          loading="lazy"
        />
      ) : (
        <div class="relative w-full h-full aspect-video flex flex-col items-center justify-center p-5 overflow-hidden text-center bg-[#0c0d12]">
          <img src={getPlaceholderImage(post.id)} alt="" class="absolute inset-0 w-full h-full object-cover z-1 opacity-90 brightness-85 contrast-110 group-hover:scale-105 transition-transform duration-300" aria-hidden="true" />
          <div class="absolute inset-0 z-2 pointer-events-none bg-[radial-gradient(circle_at_center,rgba(12,13,18,0.45)_0%,rgba(8,8,12,0.88)_100%)]"></div>
          <div class="relative z-3 flex flex-col items-center justify-center gap-1.5 max-w-[90%]">
            <div class="inline-flex items-center gap-1.5 font-mono text-[0.62rem] font-bold tracking-[0.14em] uppercase text-white/85 drop-shadow-md">
              <span class="text-[0.7rem] text-yellow-300">✦</span>
              <span>{category || 'BLOG'}</span>
            </div>
            <h4 class="font-serif text-base sm:text-lg font-semibold leading-snug text-white tracking-tight line-clamp-2 drop-shadow-lg m-0">{title}</h4>
            {description && (
              <p class="font-sans text-[0.72rem] text-white/70 line-clamp-1 max-w-[90%] m-0 drop-shadow">{description}</p>
            )}
          </div>
        </div>
      )}
    </div>

    <div class:list={[
      'p-6 flex flex-col grow',
      { 'min-[840px]:p-10 min-[840px]:justify-center': featured }
    ]}>
      <div class="flex items-center gap-1.5 text-xs text-[var(--text-muted)] mb-3 font-mono">
        <span class="inline-flex items-center gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          {readingTime}
        </span>
        <span>&bull;</span>
        <span>
          <FormattedDate date={pubDate} />
        </span>
      </div>

      <h3 class:list={[
        'font-display text-[1.35rem] font-bold leading-snug text-[var(--text-primary)] mb-2 group-hover:text-[var(--accent-primary)] transition-colors duration-200 line-clamp-2 min-h-[2.7em]',
        { 'min-[840px]:text-[1.85rem]': featured }
      ]}>{title}</h3>
      <p class:list={[
        'font-sans text-[0.95rem] text-[var(--text-secondary)] leading-relaxed mb-5 line-clamp-2 min-h-[3.1em]',
        { 'min-[840px]:line-clamp-4 min-[840px]:text-[1.05rem]': featured }
      ]}>{description}</p>

      <div class="mt-auto flex items-center justify-between pt-4 border-t border-[var(--border-subtle)]">
        <div class="flex flex-wrap gap-1.5">
          {tags.slice(0, 3).map((tag) => (
            <span class="text-xs text-[var(--text-muted)] font-mono">#{tag}</span>
          ))}
        </div>

        <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[var(--accent-primary)] group-hover:translate-x-1 transition-transform duration-200">
          Read Article
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </span>
      </div>
    </div>
  </a>
</article>
