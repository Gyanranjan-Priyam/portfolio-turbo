---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const subpath = pathname.match(/[^\/]+/g);
const isActive = href === pathname || href === '/' + (subpath?.[0] || '');
---

<a
  href={href}
  class:list={[
    'inline-flex items-center px-3.5 py-1.5 text-[0.925rem] font-medium rounded-full transition-all duration-200 no-underline',
    isActive
      ? 'text-[var(--text-primary)] bg-[var(--bg-tag-hover)] font-semibold shadow-[inset_0_0_0_1px_var(--border-subtle)]'
      : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-tag)]',
    className,
  ]}
  {...props}
>
  <slot />
</a>
