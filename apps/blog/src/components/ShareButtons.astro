---
interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;
const encodedTitle = encodeURIComponent(title);
const encodedUrl = encodeURIComponent(url);
---

<div class="flex items-center gap-3 py-5 my-8 border-t border-b border-[var(--border-subtle)]">
  <span class="text-sm font-semibold text-[var(--text-muted)]">Share article:</span>
  <div class="flex items-center gap-2">
    <a
      href={`https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-[var(--bg-tag)] border border-[var(--border-subtle)] text-[var(--text-secondary)] hover:bg-[var(--bg-tag-hover)] hover:text-[var(--text-primary)] hover:border-[var(--accent-primary)] hover:-translate-y-0.5 transition-all duration-200 cursor-pointer relative"
      aria-label="Share on X (Twitter)"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
    </a>

    <a
      href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-[var(--bg-tag)] border border-[var(--border-subtle)] text-[var(--text-secondary)] hover:bg-[var(--bg-tag-hover)] hover:text-[var(--text-primary)] hover:border-[var(--accent-primary)] hover:-translate-y-0.5 transition-all duration-200 cursor-pointer relative"
      aria-label="Share on LinkedIn"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76c.92 0 1.66-.74 1.66-1.66 0-.91-.74-1.66-1.66-1.66-.92 0-1.66.75-1.66 1.66 0 .92.74 1.66 1.66 1.66m1.39 9.74v-8.37H5.07v8.37h2.78z"/></svg>
    </a>

    <button id="copy-link-btn" class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-[var(--bg-tag)] border border-[var(--border-subtle)] text-[var(--text-secondary)] hover:bg-[var(--bg-tag-hover)] hover:text-[var(--text-primary)] hover:border-[var(--accent-primary)] hover:-translate-y-0.5 transition-all duration-200 cursor-pointer relative" aria-label="Copy link to clipboard">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>
      <span id="copy-tooltip" class="absolute -top-7 left-1/2 -translate-x-1/2 bg-[var(--text-primary)] text-[var(--text-inverted)] text-xs font-semibold px-2 py-0.5 rounded-[var(--radius-sm)] pointer-events-none opacity-0 transition-opacity duration-200 whitespace-nowrap">Copied!</span>
    </button>
  </div>
</div>

<script is:inline>
  const copyBtn = document.getElementById('copy-link-btn');
  const tooltip = document.getElementById('copy-tooltip');

  if (copyBtn && tooltip) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        tooltip.style.opacity = '1';
        setTimeout(() => { tooltip.style.opacity = '0'; }, 2000);
      } catch (err) {
        console.error('Failed to copy', err);
      }
    });
  }
</script>
