---
import { getCollection, type CollectionEntry } from 'astro:content';

interface Props {
  posts?: CollectionEntry<'blog'>[];
}

const posts = Astro.props.posts || (await getCollection('blog'));

// Prepare serialized posts data for client-side search
const searchablePosts = posts.map((post) => ({
  id: post.id,
  slug: post.id,
  title: post.data.title,
  description: post.data.description,
  tags: post.data.tags || [],
  date: post.data.pubDate.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  }),
}));

const allTags = [...new Set(posts.flatMap((p) => p.data.tags || []))].sort();
---

<!-- Spotlight Search Modal & Overlay -->
<div id="search-modal-backdrop" class="fixed inset-0 z-[9999] bg-black/75 backdrop-blur-xl flex justify-center items-start pt-[10vh] animate-[fadeIn_0.15s_ease-out]" style="display: none;">
  <div class="w-full max-w-[620px] px-4 animate-[slideDown_0.2s_cubic-bezier(0.16,1,0.3,1)]">
    <div class="w-full max-w-[600px] bg-[var(--bg-card)] border border-[var(--border-glow)] rounded-2xl shadow-[var(--shadow-lg)] overflow-hidden">
      <!-- Input Row -->
      <div class="flex items-center gap-3 px-5 py-3.5">
        <svg class="text-[var(--text-muted)] shrink-0" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>

        <input
          type="text"
          id="spotlight-search-input"
          placeholder="Search posts by title, tag, or topic..."
          autocomplete="off"
          spellcheck="false"
          class="grow bg-transparent border-none outline-none font-mono text-[0.95rem] text-[var(--text-primary)] placeholder:text-[var(--text-muted)]"
        />

        <button id="search-clear-btn" class="bg-transparent border-none text-[var(--text-muted)] hover:text-[var(--text-primary)] cursor-pointer p-1 flex items-center justify-center rounded transition-colors" aria-label="Clear search" style="display: none;">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
          </svg>
        </button>

        <kbd class="font-mono text-[0.68rem] font-semibold text-[var(--text-muted)] bg-[var(--bg-tag)] border border-[var(--border-subtle)] px-2 py-0.5 rounded cursor-pointer" id="search-close-kbd">ESC</kbd>
      </div>

      <!-- Tag Filter Pills (shown when search is active) -->
      <div id="search-tags-row" class="flex flex-wrap gap-1.5 px-5 py-2.5 border-t border-b border-[var(--border-subtle)] bg-[var(--bg-secondary)]" style="display: none;">
        {allTags.map((tag) => (
          <button class="search-tag-chip font-mono text-xs text-[var(--text-secondary)] bg-[var(--bg-tag)] hover:bg-[var(--bg-tag-hover)] hover:text-[var(--text-primary)] border border-[var(--border-subtle)] rounded-full px-2.5 py-0.5 cursor-pointer transition-all duration-150" data-tag={tag}>
            #{tag}
          </button>
        ))}
      </div>

      <!-- Results List -->
      <div id="search-results-list" class="max-h-[50vh] overflow-y-auto scrollbar-thin" style="display: none;">
        <!-- Results rendered dynamically by JS -->
      </div>
    </div>

    <!-- Keyboard Shortcut Hint -->
    <p class="text-center font-mono text-xs text-[var(--text-muted)] mt-3.5">
      Press <kbd class="inline-block bg-[var(--bg-tag)] border border-[var(--border-subtle)] rounded px-1.5 py-0.5 text-[0.7rem] text-[var(--text-muted)]">/</kbd> to search · <kbd class="inline-block bg-[var(--bg-tag)] border border-[var(--border-subtle)] rounded px-1.5 py-0.5 text-[0.7rem] text-[var(--text-muted)]">ESC</kbd> to close
    </p>
  </div>
</div>

<!-- Serialized posts data for search script -->
<script id="search-posts-data" type="application/json" is:inline set:html={JSON.stringify(searchablePosts)}></script>

<script is:inline>
  (function () {
    const backdrop = document.getElementById('search-modal-backdrop');
    const input = document.getElementById('spotlight-search-input');
    const clearBtn = document.getElementById('search-clear-btn');
    const tagsRow = document.getElementById('search-tags-row');
    const resultsList = document.getElementById('search-results-list');
    const closeKbd = document.getElementById('search-close-kbd');
    const postsDataEl = document.getElementById('search-posts-data');

    let allPosts = [];
    try {
      if (postsDataEl) {
        allPosts = JSON.parse(postsDataEl.textContent || '[]');
      }
    } catch (e) {
      console.error('Failed to parse search posts', e);
    }

    let activeTag = null;

    function openSearch() {
      if (!backdrop) return;
      backdrop.style.display = 'flex';
      document.body.style.overflow = 'hidden';
      setTimeout(() => {
        if (input) {
          input.focus();
          renderResults();
        }
      }, 50);
    }

    function closeSearch() {
      if (!backdrop) return;
      backdrop.style.display = 'none';
      document.body.style.overflow = '';
      if (input) input.value = '';
      activeTag = null;
      document.querySelectorAll('.search-tag-chip').forEach(c => {
        c.classList.remove('!bg-[var(--text-primary)]', '!text-[var(--text-inverted)]', '!border-[var(--text-primary)]', 'font-semibold');
      });
      if (clearBtn) clearBtn.style.display = 'none';
      if (tagsRow) tagsRow.style.display = 'none';
      if (resultsList) resultsList.style.display = 'none';
    }

    function highlightText(text, query) {
      if (!query || !query.trim()) return text;
      const escaped = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      const regex = new RegExp(`(${escaped})`, 'gi');
      return text.replace(regex, '<span class="bg-amber-400/25 dark:bg-amber-400/30 text-amber-700 dark:text-amber-300 rounded-xs px-0.5 font-semibold">$1</span>');
    }

    function renderResults() {
      if (!resultsList || !tagsRow) return;
      const query = input ? input.value.trim().toLowerCase() : '';

      if (clearBtn) {
        clearBtn.style.display = query ? 'flex' : 'none';
      }

      if (query || activeTag) {
        tagsRow.style.display = 'flex';
        resultsList.style.display = 'block';

        const filtered = allPosts.filter((post) => {
          const matchesTag = activeTag ? post.tags.includes(activeTag) : true;
          if (!query) return matchesTag;
          const matchesQuery =
            post.title.toLowerCase().includes(query) ||
            post.description.toLowerCase().includes(query) ||
            post.tags.some((t) => t.toLowerCase().includes(query));
          return matchesQuery && matchesTag;
        });

        if (filtered.length === 0) {
          resultsList.innerHTML = `
            <div class="py-10 px-6 text-center text-[var(--text-muted)] font-mono text-sm">
              <p>No posts found for "${query || activeTag}"</p>
            </div>
          `;
        } else {
          resultsList.innerHTML = filtered
            .map((post) => {
              const highlightedTitle = highlightText(post.title, query);
              const highlightedDesc = highlightText(post.description, query);
              const tagsHtml = post.tags
                .slice(0, 3)
                .map((t) => `<span class="font-mono text-[0.68rem] text-[var(--text-secondary)] bg-[var(--bg-tag)] border border-[var(--border-subtle)] rounded px-1.5 py-0.5">#${highlightText(t, query)}</span>`)
                .join('');

              return `
                <a href="/${post.slug}" class="block no-underline px-5 py-3.5 border-b border-[var(--border-subtle)] hover:bg-[var(--bg-card-hover)] transition-colors duration-150">
                  <div class="flex items-start justify-between gap-3 mb-1.5">
                    <h3 class="text-[0.92rem] font-semibold text-[var(--text-primary)] m-0">${highlightedTitle}</h3>
                    <span class="font-mono text-xs text-[var(--text-muted)] whitespace-nowrap shrink-0">${post.date}</span>
                  </div>
                  <p class="font-mono text-xs text-[var(--text-secondary)] leading-relaxed mb-2 line-clamp-2">${highlightedDesc}</p>
                  <div class="flex flex-wrap gap-1.5">${tagsHtml}</div>
                </a>
              `;
            })
            .join('');
        }
      } else {
        tagsRow.style.display = 'none';
        resultsList.style.display = 'none';
        resultsList.innerHTML = '';
      }
    }

    // Tag chip clicks
    document.querySelectorAll('.search-tag-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        const tag = chip.getAttribute('data-tag');
        const activeClasses = ['!bg-[var(--text-primary)]', '!text-[var(--text-inverted)]', '!border-[var(--text-primary)]', 'font-semibold'];
        if (activeTag === tag) {
          activeTag = null;
          chip.classList.remove(...activeClasses);
        } else {
          document.querySelectorAll('.search-tag-chip').forEach(c => c.classList.remove(...activeClasses));
          activeTag = tag;
          chip.classList.add(...activeClasses);
        }
        renderResults();
      });
    });

    if (input) {
      input.addEventListener('input', renderResults);
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        if (input) input.value = '';
        activeTag = null;
        document.querySelectorAll('.search-tag-chip').forEach(c => {
          c.classList.remove('!bg-[var(--text-primary)]', '!text-[var(--text-inverted)]', '!border-[var(--text-primary)]', 'font-semibold');
        });
        renderResults();
        if (input) input.focus();
      });
    }

    if (closeKbd) {
      closeKbd.addEventListener('click', closeSearch);
    }

    if (backdrop) {
      backdrop.addEventListener('click', (e) => {
        if (e.target === backdrop) closeSearch();
      });
    }

    // Global keyboard shortcuts: Ctrl+K / Cmd+K / "/" to open, "Escape" to close
    window.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K')) {
        e.preventDefault();
        const isOpen = backdrop && backdrop.style.display && backdrop.style.display !== 'none';
        if (isOpen) {
          closeSearch();
        } else {
          openSearch();
        }
        return;
      }

      if (
        e.key === '/' &&
        (!backdrop || backdrop.style.display === 'none' || backdrop.style.display === '') &&
        !(e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement || (e.target && e.target.isContentEditable))
      ) {
        e.preventDefault();
        openSearch();
        return;
      }

      if (e.key === 'Escape' && backdrop && backdrop.style.display !== 'none' && backdrop.style.display !== '') {
        e.preventDefault();
        closeSearch();
      }
    });

    window.openSpotlightSearch = openSearch;
  })();
</script>
