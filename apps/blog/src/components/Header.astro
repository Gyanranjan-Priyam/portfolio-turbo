---
import HeaderLink from "./HeaderLink.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { AUTHOR_PORTFOLIO } from "../consts";
---

<header class="sticky top-0 z-50 w-full py-3 backdrop-blur-xl bg-[var(--bg-glass)] border-b border-[var(--border-subtle)] transition-all duration-300">
  <div class="max-w-[1160px] mx-auto px-6 flex items-center justify-between">
    <div class="flex items-center">
      <a href="/" class="flex items-center gap-3 no-underline">
        <img
          src="/logo.png"
          alt="Logo"
          width="34"
          height="34"
          class="w-[34px] h-[34px] object-contain shrink-0"
        />
        <div class="flex flex-col">
          <span class="font-display font-bold text-[1.05rem] text-[var(--text-primary)] leading-tight">Priyam's Blog</span>
          <span class="text-xs text-[var(--text-muted)] leading-none hidden sm:block">Tech, Design & Systems</span>
        </div>
      </a>
    </div>

    <nav class="flex items-center gap-1 bg-[var(--bg-tag)] p-1 rounded-full border border-[var(--border-subtle)]">
      <HeaderLink href="/">Home</HeaderLink>
      <HeaderLink href="/about">About</HeaderLink>
    </nav>

    <div class="flex items-center gap-3">
      <ThemeToggle />
      <a
        href={AUTHOR_PORTFOLIO}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-4 py-2 sm:px-4 sm:py-2 text-[0.85rem] font-semibold text-[var(--text-primary)] bg-[var(--bg-tag)] border border-[var(--border-subtle)] rounded-full no-underline transition-all duration-200 hover:bg-[var(--bg-tag-hover)] hover:border-[var(--accent-primary)] hover:text-[var(--accent-primary)] hover:-translate-y-0.5"
      >
        <span class="hidden sm:inline">Portfolio</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M7 7h10v10"></path>
          <path d="M7 17 17 7"></path>
        </svg>
      </a>
    </div>
  </div>
</header>
