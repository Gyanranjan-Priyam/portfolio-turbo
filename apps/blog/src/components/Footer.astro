---
import { AUTHOR_PORTFOLIO } from '../consts';

const today = new Date();

const navLinks = [
  { label: 'About', href: `${AUTHOR_PORTFOLIO}/#about` },
  { label: 'Skills', href: `${AUTHOR_PORTFOLIO}/#skills` },
  { label: 'Projects', href: `${AUTHOR_PORTFOLIO}/projects` },
  { label: 'Blog', href: '/' },
  { label: 'Contact', href: `${AUTHOR_PORTFOLIO}/#contact` },
];
---

<footer class="site-footer">
  <div class="footer-inner">
    <!-- Top Center: Logo & Name -->
    <div class="brand-center">
      <a href="/" class="brand-link">
        <img src="/logo.png" alt="Logo" width="40" height="40" class="footer-logo" />
        <span class="brand-name">GYANRANJAN PRIYAM</span>
      </a>
    </div>

    <!-- Nav links in monospace -->
    <nav class="footer-nav">
      {navLinks.map((link) => (
        <a href={link.href} class="nav-item">
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Dotted divider -->
    <div class="footer-divider"></div>

    <!-- Bottom row -->
    <div class="footer-bottom">
      <p class="copyright">&copy; {today.getFullYear()} Gyanranjan Priyam</p>

      <a href={`${AUTHOR_PORTFOLIO}/privacy`} class="privacy-link">
        Privacy Policy
      </a>

      <div class="social-row">
        <!-- Twitter / X -->
        <a
          href="https://x.com/gr_priyam"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Twitter / X"
          class="social-icon-btn"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
          </svg>
        </a>

        <!-- LinkedIn -->
        <a
          href="https://linkedin.com/in/gyanranjan-priyam"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="social-icon-btn"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="#0A66C2">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
          </svg>
        </a>

        <!-- GitHub -->
        <a
          href="https://github.com/gyanranjan-priyam"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="social-icon-btn"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"></path>
          </svg>
        </a>

        <!-- Instagram -->
        <a
          href="https://instagram.com/gyanranjanpriyam"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class="social-icon-btn"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="#E4405F">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"></path>
          </svg>
        </a>

        <!-- Gmail / Email -->
        <a
          href="mailto:info@priyam.tech"
          aria-label="Email"
          class="social-icon-btn"
        >
          <svg viewBox="0 0 256 193" width="18" height="18">
            <path fill="#4285F4" d="M58.182 192.05V93.14L27.507 65.077 0 49.504v125.091c0 9.658 7.825 17.455 17.455 17.455z"></path>
            <path fill="#34A853" d="M197.818 192.05h40.727c9.659 0 17.455-7.826 17.455-17.455V49.505l-31.156 17.837-27.026 25.798z"></path>
            <path fill="#EA4335" d="M58.182 93.14l-4.174-38.647 4.174-36.989L128 69.868l69.818-52.364 4.669 34.992-4.669 40.644L128 145.504z"></path>
            <path fill="#FBBC04" d="M197.818 17.504V93.14L256 49.504V26.231c0-21.585-24.64-33.89-41.89-20.945z"></path>
            <path fill="#C5221F" d="M0 49.504l26.759 20.07L58.182 93.14V17.504L41.89 5.286C24.61-7.66 0 4.646 0 26.23z"></path>
          </svg>
        </a>

        <!-- Dark/Light Theme Toggle Icon Button -->
        <button id="footer-theme-toggle" class="social-icon-btn theme-toggle-footer" aria-label="Toggle theme" title="Toggle Dark / Light theme">
          <svg class="footer-sun-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <svg class="footer-moon-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    margin-top: auto;
    padding: 2rem 0 2.5rem;
    position: relative;
    z-index: 10;
  }

  .footer-inner {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .brand-center {
    display: flex;
    justify-content: center;
    margin-bottom: 1rem;
  }

  .brand-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    text-decoration: none;
    color: inherit;
  }

  .footer-logo {
    width: 40px;
    height: 40px;
    object-fit: contain;
  }

  .brand-name {
    font-family: var(--font-mokoto);
    font-size: 1.15rem;
    letter-spacing: 0.18em;
    color: var(--text-primary);
    text-transform: uppercase;
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin: 0.75rem 0 2rem;
  }

  .nav-item {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nav-item:hover {
    color: var(--text-primary);
  }

  .footer-divider {
    width: 100%;
    max-width: 768px;
    height: 2.5px;
    background-image: radial-gradient(circle, var(--dotted-border) 1.25px, transparent 1.25px);
    background-size: 10px 2.5px;
    background-repeat: repeat-x;
    background-position: center;
    border: none;
    margin-bottom: 1.75rem;
  }

  .footer-bottom {
    width: 100%;
    max-width: 768px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .copyright {
    margin: 0;
  }

  .privacy-link {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .privacy-link:hover {
    color: var(--text-primary);
  }

  .social-row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .social-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    transition: all 0.2s ease;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .social-icon-btn:hover {
    color: var(--text-primary);
    transform: translateY(-1px);
  }

  /* Theme toggle icons */
  .footer-sun-icon {
    display: none;
  }
  .footer-moon-icon {
    display: block;
  }

  :global(html.dark) .footer-sun-icon {
    display: block !important;
  }
  :global(html.dark) .footer-moon-icon {
    display: none !important;
  }

  :global(html:not(.dark)) .footer-sun-icon {
    display: none !important;
  }
  :global(html:not(.dark)) .footer-moon-icon {
    display: block !important;
  }

  @media (max-width: 640px) {
    .footer-bottom {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 1.25rem;
    }
  }
</style>

<script is:inline>
  function setupFooterThemeToggle() {
    const btn = document.getElementById('footer-theme-toggle');
    if (!btn) return;

    btn.onclick = (e) => {
      e.preventDefault();
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    };
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupFooterThemeToggle);
  } else {
    setupFooterThemeToggle();
  }
  document.addEventListener('astro:after-swap', setupFooterThemeToggle);
</script>
