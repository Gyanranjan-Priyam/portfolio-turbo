---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { SITE_DESCRIPTION, AUTHOR_PORTFOLIO } from '../consts';
import '../styles/home.css';

const allPosts = await getCollection('blog');
const posts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Collect all unique categories
const categories = ['All', ...new Set(posts.map((p) => p.data.category || 'Engineering'))];

// Color mapping helper for category badges
const getCategoryColorClass = (cat: string) => {
  const c = cat.toLowerCase();
  if (c.includes('engineering') || c.includes('tech')) return 'cat-cyan';
  if (c.includes('career') || c.includes('journey')) return 'cat-orange';
  if (c.includes('web') || c.includes('dev')) return 'cat-purple';
  if (c.includes('guide') || c.includes('tutorial')) return 'cat-green';
  return 'cat-rose';
};
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="The Priyam's Blog | Gyanranjan Priyam" description={SITE_DESCRIPTION} />
  </head>
  <body>
    <main class="blogs-main-wrapper">
      <div class="blogs-container border-dotted-side">
        <div style="flex: 1; display: flex; flex-direction: column; width: 100%;">
        
        <!-- MINIMAL TOP BAR -->
        <header class="blogs-minimal-topbar">
          <a href="/" class="topbar-brand" aria-label="Priyam's Blog Home">
            <img src="/logo.png" alt="Logo" class="topbar-logo" width="28" height="28" />
            <span class="topbar-name">Priyam's Blog</span>
          </a>

          <div class="topbar-actions">
            <!-- Theme Toggle -->
            <ThemeToggle />

            <!-- Portfolio Link -->
            <a
              href={AUTHOR_PORTFOLIO}
              target="_blank"
              rel="noopener noreferrer"
              class="topbar-action-btn"
            >
              <span>Portfolio</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </a>
          </div>
        </header>

        <!-- Dotted Separator below Top Bar -->
        <div class="separator-dotted-h home-topbar-separator"></div>

        <!-- HERO SECTION -->
        <section class="blog-hero">
          <h1 class="hero-brand-title">
            The <span class="font-brand-cooper">Priyam's</span> Blog
          </h1>

          <p class="hero-subtitle">
            Articles, tutorials, and practical insights on web development and engineering.
          </p>

          <!-- Search Bar Pill -->
          <div class="hero-search-box">
            <button
              id="hero-search-trigger-btn"
              class="hero-search-pill-btn"
              type="button"
              aria-label="Search articles"
              title="Search articles (Ctrl+K)"
            >
              <div class="search-pill-left">
                <svg
                  class="search-icon"
                  xmlns="http://www.w3.org/2000/svg"
                  width="16" height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="11" cy="11" r="8"></circle>
                  <path d="m21 21-4.3-4.3"></path>
                </svg>
                <span class="search-placeholder-text">Search articles...</span>
              </div>
              <div class="search-pill-right">
                <kbd class="search-kbd-chip">Ctrl K</kbd>
              </div>
            </button>
          </div>

          <!-- Category Filter Tabs -->
          <nav class="category-tabs-nav" aria-label="Filter posts by category">
            <div class="category-tabs-scroll" id="category-tabs-container">
              {categories.map((cat, idx) => (
                <button
                  type="button"
                  class={`cat-tab-btn ${idx === 0 ? 'active' : ''}`}
                  data-category={cat}
                >
                  {cat}
                </button>
              ))}
            </div>
          </nav>
        </section>

        <!-- Dotted Separator between Hero/Filters and Posts Feed -->
        <div class="separator-dotted-h home-hero-separator"></div>

        <!-- POSTS FEED SECTION -->
        <section class="posts-feed-section" id="posts-feed-section">
          <div class="featured-posts-grid" id="featured-posts-grid">
            {posts.map((post) => {
              const imageSrc = post.data.heroImage
                ? typeof post.data.heroImage === 'string'
                  ? post.data.heroImage
                  : post.data.heroImage.src
                : null;
              const cat = post.data.category || 'Engineering';
              const colorClass = getCategoryColorClass(cat);

              return (
                <article
                  class="featured-post-card"
                  data-post-card
                  data-category={cat}
                  data-tags={JSON.stringify(post.data.tags || [])}
                  data-title={post.data.title.toLowerCase()}
                  data-desc={post.data.description.toLowerCase()}
                >
                  <a href={`/${post.id}`} class="card-link-wrapper" aria-label={post.data.title}>
                    <!-- Visual Cover / Thumbnail -->
                    <div class="post-cover-frame">
                      {imageSrc ? (
                        <img
                          src={imageSrc}
                          alt={post.data.title}
                          loading="lazy"
                          class="post-cover-img"
                        />
                      ) : (
                        <div class="post-cover-fallback">
                          <span class="fallback-title">{post.data.title}</span>
                        </div>
                      )}
                      <div class="cover-overlay-badge">
                        <span class="play-icon">▶</span>
                        <span>{post.data.readingTime || '5 min read'}</span>
                      </div>
                    </div>

                    <!-- Post Info -->
                    <div class="featured-post-body">
                      <div class={`post-cat-label ${colorClass}`}>
                        <span class="cat-bar"></span>
                        <span class="cat-text">{cat}</span>
                      </div>

                      <h2 class="featured-post-title">
                        {post.data.title}
                      </h2>

                      <p class="featured-post-excerpt">
                        {post.data.description}
                      </p>

                      <div class="post-meta-row">
                        <span class="post-meta-date">
                          <FormattedDate date={post.data.pubDate} />
                        </span>
                        <span class="meta-dot">·</span>
                        <span class="post-meta-reading-time">{post.data.readingTime || '5 min read'}</span>
                      </div>
                    </div>
                  </a>
                </article>
              );
            })}
          </div>

          <!-- Empty State when filtering yields 0 items -->
          <div id="no-posts-found" class="no-posts-empty-state" style="display: none;">
            <div class="empty-icon">🔍</div>
            <h3 class="empty-title">No articles found</h3>
            <p class="empty-desc">Try selecting another category or clear your search term.</p>
            <button id="reset-filter-btn" class="reset-filter-btn" type="button">
              Reset Filters
            </button>
          </div>
        </section>

        <!-- PAGINATION SECTION -->
        <div class="pagination-section" id="pagination-section">
          <nav class="pagination-controls" aria-label="Pagination">
            <button
              id="pg-prev-btn"
              class="pg-btn pg-arrow disabled"
              type="button"
              disabled
              aria-label="Previous page"
            >
              &lt; Prev
            </button>

            <div id="pg-numbers-container" class="pg-numbers-wrap">
              <button type="button" class="pg-btn pg-num active" data-page="1">1</button>
            </div>

            <button
              id="pg-next-btn"
              class="pg-btn pg-arrow disabled"
              type="button"
              disabled
              aria-label="Next page"
            >
              Next &gt;
            </button>
          </nav>
          <p id="pg-summary-text" class="pg-summary-text">
            Showing all {posts.length} posts
          </p>
        </div>

        </div>

        <!-- Dotted Separator before Footer -->
        <div class="separator-dotted-h"></div>
        <Footer />
      </div>
    </main>

    <!-- Spotlight Search Modal -->
    <SearchModal posts={posts} />

    <script is:inline>
      (function () {
        // Search Trigger Integration
        const searchTriggerBtn = document.getElementById('hero-search-trigger-btn');
        if (searchTriggerBtn) {
          searchTriggerBtn.addEventListener('click', () => {
            if (typeof window.openSpotlightSearch === 'function') {
              window.openSpotlightSearch();
            }
          });
        }

        // Category Tab Filtering & Pagination
        const categoryTabs = document.querySelectorAll('.cat-tab-btn');
        const postCards = Array.from(document.querySelectorAll('[data-post-card]'));
        const featuredGrid = document.getElementById('featured-posts-grid');
        const emptyState = document.getElementById('no-posts-found');
        const resetBtn = document.getElementById('reset-filter-btn');

        const prevBtn = document.getElementById('pg-prev-btn');
        const nextBtn = document.getElementById('pg-next-btn');
        const numbersContainer = document.getElementById('pg-numbers-container');
        const summaryText = document.getElementById('pg-summary-text');

        const PAGE_SIZE = 6;
        let currentCategory = 'All';
        let currentPage = 1;

        function getFilteredPosts() {
          if (currentCategory === 'All') return postCards;
          return postCards.filter((card) => {
            const cat = card.getAttribute('data-category') || '';
            const tags = JSON.parse(card.getAttribute('data-tags') || '[]');
            return cat.toLowerCase() === currentCategory.toLowerCase() || 
                   tags.some(t => t.toLowerCase() === currentCategory.toLowerCase());
          });
        }

        function renderPagination(filteredList) {
          const total = filteredList.length;
          const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
          if (currentPage > totalPages) currentPage = totalPages;

          postCards.forEach((c) => (c.style.display = 'none'));

          if (total === 0) {
            if (emptyState) emptyState.style.display = 'block';
            if (featuredGrid) featuredGrid.style.display = 'none';
          } else {
            if (emptyState) emptyState.style.display = 'none';
            if (featuredGrid) featuredGrid.style.display = 'grid';

            const startIndex = (currentPage - 1) * PAGE_SIZE;
            const endIndex = startIndex + PAGE_SIZE;

            filteredList.slice(startIndex, endIndex).forEach((card) => {
              card.style.display = '';
            });
          }

          if (prevBtn) {
            prevBtn.disabled = currentPage <= 1;
            prevBtn.classList.toggle('disabled', currentPage <= 1);
          }
          if (nextBtn) {
            nextBtn.disabled = currentPage >= totalPages;
            nextBtn.classList.toggle('disabled', currentPage >= totalPages);
          }

          if (numbersContainer) {
            numbersContainer.innerHTML = '';
            for (let i = 1; i <= totalPages; i++) {
              const btn = document.createElement('button');
              btn.type = 'button';
              btn.className = `pg-btn pg-num ${i === currentPage ? 'active' : ''}`;
              btn.textContent = String(i);
              btn.setAttribute('data-page', String(i));
              btn.addEventListener('click', () => {
                currentPage = i;
                renderPagination(filteredList);
                scrollToFeed();
              });
              numbersContainer.appendChild(btn);
            }
          }

          if (summaryText) {
            summaryText.textContent = `Showing page ${currentPage} of ${totalPages} · ${total} ${total === 1 ? 'post' : 'posts'}`;
          }
        }

        function scrollToFeed() {
          const feed = document.getElementById('posts-feed-section');
          if (feed) {
            feed.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }

        categoryTabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            categoryTabs.forEach((t) => t.classList.remove('active'));
            tab.classList.add('active');
            currentCategory = tab.getAttribute('data-category') || 'All';
            currentPage = 1;
            renderPagination(getFilteredPosts());
          });
        });

        if (resetBtn) {
          resetBtn.addEventListener('click', () => {
            currentCategory = 'All';
            currentPage = 1;
            categoryTabs.forEach((t) => {
              t.classList.toggle('active', t.getAttribute('data-category') === 'All');
            });
            renderPagination(getFilteredPosts());
          });
        }

        if (prevBtn) {
          prevBtn.addEventListener('click', () => {
            if (currentPage > 1) {
              currentPage--;
              renderPagination(getFilteredPosts());
              scrollToFeed();
            }
          });
        }

        if (nextBtn) {
          nextBtn.addEventListener('click', () => {
            const totalPages = Math.ceil(getFilteredPosts().length / PAGE_SIZE);
            if (currentPage < totalPages) {
              currentPage++;
              renderPagination(getFilteredPosts());
              scrollToFeed();
            }
          });
        }

        // Initial render
        renderPagination(getFilteredPosts());
      })();
    </script>
  </body>
</html>
