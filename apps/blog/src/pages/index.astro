---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import HatchDivider from '../components/HatchDivider.astro';
import { SITE_DESCRIPTION, AUTHOR_PORTFOLIO } from '../consts';

import placeholder2 from '../assets/blog-placeholder-2.jpg';
import placeholder3 from '../assets/blog-placeholder-3.jpg';
import placeholder4 from '../assets/blog-placeholder-4.jpg';
import placeholder5 from '../assets/blog-placeholder-5.jpg';

const placeholders = [placeholder2, placeholder3, placeholder4, placeholder5];

const getPlaceholderImage = (id: string) => {
  let hash = 0;
  for (let i = 0; i < id.length; i++) {
    hash = (hash << 5) - hash + id.charCodeAt(i);
    hash |= 0;
  }
  return placeholders[Math.abs(hash) % placeholders.length].src;
};

const allPosts = await getCollection('blog');
const posts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Collect all unique categories
const categories = ['All', ...new Set(posts.map((p) => p.data.category || 'Engineering'))];

// Color mapping helper for category badges
const getCategoryColorClass = (cat: string) => {
  const c = cat.toLowerCase();
  if (c.includes('engineering') || c.includes('tech')) return 'text-sky-600 dark:text-sky-400 [&_.cat-bar]:bg-sky-600 dark:[&_.cat-bar]:bg-sky-400';
  if (c.includes('career') || c.includes('journey')) return 'text-orange-600 dark:text-orange-400 [&_.cat-bar]:bg-orange-600 dark:[&_.cat-bar]:bg-orange-400';
  if (c.includes('web') || c.includes('dev')) return 'text-purple-600 dark:text-purple-400 [&_.cat-bar]:bg-purple-600 dark:[&_.cat-bar]:bg-purple-400';
  if (c.includes('guide') || c.includes('tutorial')) return 'text-green-600 dark:text-green-400 [&_.cat-bar]:bg-green-600 dark:[&_.cat-bar]:bg-green-400';
  return 'text-rose-600 dark:text-rose-400 [&_.cat-bar]:bg-rose-600 dark:[&_.cat-bar]:bg-rose-400';
};
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="The Priyam's Blog | Gyanranjan Priyam" description={SITE_DESCRIPTION} />
  </head>
  <body class="bg-[var(--bg-primary)] text-[var(--text-primary)] min-h-screen flex flex-col font-sans">
    <main class="min-h-screen p-0 bg-[var(--bg-primary)] w-full flex flex-col">
      <div class="max-w-[1080px] mx-auto w-full px-5 sm:px-9 pt-8 pb-18 min-h-screen flex flex-col border-dotted-side">
        <div class="flex-1 flex flex-col w-full">
        
        <!-- MINIMAL TOP BAR -->
        <header class="flex items-center justify-between pb-2 w-full">
          <a href="/" class="group inline-flex items-center gap-2.5 text-inherit no-underline text-[var(--text-primary)]" aria-label="Priyam's Blog Home">
            <img src="/logo.png" alt="Logo" class="w-7 h-7 object-contain group-hover:scale-105 transition-transform duration-200" width="28" height="28" />
            <span class="font-display font-bold text-[0.95rem] tracking-tight text-[var(--text-primary)]">Priyam's Blog</span>
          </a>

          <div class="flex items-center gap-2">
            <!-- Theme Toggle -->
            <ThemeToggle />

            <!-- Portfolio Link -->
            <a
              href={AUTHOR_PORTFOLIO}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[var(--bg-tag)] hover:bg-[var(--bg-tag-hover)] border border-[var(--border-subtle)] hover:border-[var(--border-glow)] font-sans text-[0.8rem] font-medium text-[var(--text-secondary)] hover:text-[var(--text-primary)] no-underline cursor-pointer transition-all duration-150"
            >
              <span>Portfolio</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </a>
          </div>
        </header>

        <!-- Hatch Pattern Separator below Top Bar -->
        <HatchDivider class="!mt-0 !mb-7" />

        <!-- HERO SECTION -->
        <section class="flex flex-col items-center text-center my-2 mb-8 w-full">
          <h1 class="font-display text-4xl sm:text-5xl md:text-6xl font-bold leading-tight tracking-tight text-[var(--text-primary)] mb-2.5">
            The <span class="font-cooper italic font-bold tracking-tight px-1 inline-block text-[var(--text-primary)]">Priyam's</span> Blog
          </h1>

          <p class="font-sans text-sm sm:text-base text-[var(--text-secondary)] max-w-[520px] mx-auto mb-7 leading-relaxed">
            Articles, tutorials, and practical insights on web development and engineering.
          </p>

          <!-- Search Bar Pill -->
          <div class="w-full max-w-[380px] mx-auto mb-7">
            <button
              id="hero-search-trigger-btn"
              class="w-full flex items-center justify-between gap-2.5 px-4 py-2 bg-[var(--bg-card)] hover:bg-[var(--bg-card-hover)] border border-[var(--border-subtle)] hover:border-[var(--border-glow)] rounded-full shadow-[var(--shadow-sm)] cursor-pointer transition-all duration-200 text-[var(--text-secondary)] hover:text-[var(--text-primary)]"
              type="button"
              aria-label="Search articles"
              title="Search articles (Ctrl+K)"
            >
              <div class="flex items-center gap-2 text-[var(--text-muted)]">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16" height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="11" cy="11" r="8"></circle>
                  <path d="m21 21-4.3-4.3"></path>
                </svg>
                <span class="font-sans text-[0.85rem]">Search articles...</span>
              </div>
              <div>
                <kbd class="font-mono text-[0.68rem] font-semibold px-1.5 py-0.5 rounded bg-[var(--bg-tag)] border border-[var(--border-subtle)] text-[var(--text-muted)]">Ctrl K</kbd>
              </div>
            </button>
          </div>

          <!-- Category Filter Tabs -->
          <nav class="w-full max-w-[720px] mx-auto" aria-label="Filter posts by category">
            <div class="flex items-center justify-start sm:justify-center flex-nowrap sm:flex-wrap gap-1.5 overflow-x-auto sm:overflow-visible pb-1 sm:pb-0 scrollbar-none" id="category-tabs-container">
              {categories.map((cat, idx) => (
                <button
                  type="button"
                  class="cat-tab-btn inline-flex items-center px-3.5 py-1.5 rounded-full font-sans text-[0.78rem] font-medium border cursor-pointer transition-all duration-150 whitespace-nowrap shrink-0 text-[var(--text-secondary)] hover:text-[var(--text-primary)] bg-[var(--bg-card)] hover:bg-[var(--bg-card-hover)] border-[var(--border-subtle)] hover:border-[var(--border-glow)] aria-selected:text-[var(--text-inverted)] aria-selected:bg-[var(--text-primary)] aria-selected:border-[var(--text-primary)] aria-selected:font-semibold"
                  data-category={cat}
                  aria-selected={idx === 0 ? "true" : "false"}
                >
                  {cat}
                </button>
              ))}
            </div>
          </nav>
        </section>

        <!-- Hatch Pattern Separator between Hero/Filters and Posts Feed -->
        <HatchDivider class="!mt-0 !mb-10" />

        <!-- POSTS FEED SECTION -->
        <section class="w-full" id="posts-feed-section">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-7 mb-10 w-full" id="featured-posts-grid">
            {posts.map((post) => {
              const imageSrc = post.data.heroImage
                ? typeof post.data.heroImage === 'string'
                  ? post.data.heroImage
                  : post.data.heroImage.src
                : null;
              const cat = post.data.category || 'Engineering';
              const colorClass = getCategoryColorClass(cat);
              const fallbackBg = getPlaceholderImage(post.id);

              return (
                <article
                  class="group flex flex-col rounded-[var(--radius-lg)] w-full"
                  data-post-card
                  data-category={cat}
                  data-tags={JSON.stringify(post.data.tags || [])}
                  data-title={post.data.title.toLowerCase()}
                  data-desc={post.data.description.toLowerCase()}
                >
                  <a href={`/${post.id}`} class="flex flex-col h-full no-underline text-inherit" aria-label={post.data.title}>
                    <!-- Visual Cover / Thumbnail -->
                    <div class="relative w-full aspect-video rounded-[var(--radius-md)] overflow-hidden border border-[var(--border-subtle)] group-hover:border-[var(--border-glow)] mb-3.5 transition-all duration-200">
                      {imageSrc ? (
                        <img
                          src={imageSrc}
                          alt={post.data.title}
                          loading="lazy"
                          class="w-full h-full object-cover object-center block"
                        />
                      ) : (
                        <div class="relative w-full h-full aspect-video flex flex-col items-center justify-center p-5 overflow-hidden text-center bg-[#0c0d12]">
                          <img src={fallbackBg} alt="" class="absolute inset-0 w-full h-full object-cover z-1 opacity-90 brightness-85 contrast-110 group-hover:scale-105 transition-transform duration-350" aria-hidden="true" />
                          <div class="absolute inset-0 z-2 pointer-events-none bg-[radial-gradient(circle_at_center,rgba(12,13,18,0.45)_0%,rgba(8,8,12,0.88)_100%)]"></div>
                          <div class="relative z-3 flex flex-col items-center justify-center gap-1.5 max-w-[90%]">
                            <div class="inline-flex items-center gap-1.5 font-mono text-[0.62rem] font-bold tracking-[0.14em] uppercase text-white/85 drop-shadow-md">
                              <span class="text-[0.7rem] text-yellow-300">✦</span>
                              <span>{post.data.category || 'BLOG'}</span>
                            </div>
                            <h3 class="font-serif text-base sm:text-lg font-semibold leading-snug text-white tracking-tight line-clamp-2 drop-shadow-lg m-0">{post.data.title}</h3>
                            {post.data.description && (
                              <p class="font-sans text-[0.72rem] text-white/70 line-clamp-1 max-w-[90%] m-0 drop-shadow">{post.data.description}</p>
                            )}
                          </div>
                        </div>
                      )}
                      <div class="absolute top-2.5 left-2.5 inline-flex items-center gap-1 px-2 py-0.5 bg-[rgba(10,10,12,0.75)] backdrop-blur-md border border-white/15 rounded-[var(--radius-sm)] font-mono text-[0.68rem] font-medium text-slate-100">
                        <span class="text-[0.55rem] opacity-85">▶</span>
                        <span>{post.data.readingTime || '5 min read'}</span>
                      </div>
                    </div>

                    <!-- Post Info -->
                    <div class="flex flex-col flex-1">
                      <div class={`inline-flex items-center gap-1.5 font-mono text-[0.68rem] font-bold tracking-wider uppercase mb-1.5 ${colorClass}`}>
                        <span class="cat-bar inline-block w-[3px] h-2.5 rounded-xs"></span>
                        <span>{cat}</span>
                      </div>

                      <h2 class="font-display text-[1.15rem] font-bold leading-snug tracking-tight text-[var(--text-primary)] mb-1.5 group-hover:text-[var(--accent-primary)] transition-colors duration-150 line-clamp-2 min-h-[2.7em]">
                        {post.data.title}
                      </h2>

                      <p class="font-sans text-[0.85rem] leading-relaxed text-[var(--text-secondary)] mb-3 line-clamp-2 min-h-[3.1em]">
                        {post.data.description}
                      </p>

                      <div class="flex items-center gap-1.5 font-mono text-xs text-[var(--text-muted)] mt-auto">
                        <span>
                          <FormattedDate date={post.data.pubDate} />
                        </span>
                        <span class="opacity-50">·</span>
                        <span>{post.data.readingTime || '5 min read'}</span>
                      </div>
                    </div>
                  </a>
                </article>
              );
            })}
          </div>

          <!-- Empty State when filtering yields 0 items -->
          <div id="no-posts-found" class="text-center py-12 px-6 bg-[var(--bg-card)] border border-dashed border-[var(--border-subtle)] rounded-[var(--radius-lg)] my-8" style="display: none;">
            <div class="text-3xl mb-3">🔍</div>
            <h3 class="text-lg font-bold text-[var(--text-primary)] mb-1.5">No articles found</h3>
            <p class="text-sm text-[var(--text-muted)] mb-5">Try selecting another category or clear your search term.</p>
            <button id="reset-filter-btn" class="inline-flex items-center px-4 py-2 rounded-full bg-[var(--text-primary)] text-[var(--text-inverted)] border-none text-xs font-semibold cursor-pointer" type="button">
              Reset Filters
            </button>
          </div>
        </section>

        <!-- PAGINATION SECTION -->
        <div class="flex flex-col items-center gap-2 mt-10 mb-4" id="pagination-section">
          <nav class="inline-flex items-center gap-1.5" aria-label="Pagination">
            <button
              id="pg-prev-btn"
              class="pg-btn inline-flex items-center justify-center min-w-8 h-8 px-2 rounded-[var(--radius-sm)] font-mono text-[0.78rem] bg-transparent border border-transparent text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-tag-hover)] hover:border-[var(--border-subtle)] cursor-pointer transition-all duration-150 disabled:opacity-35 disabled:cursor-not-allowed"
              type="button"
              disabled
              aria-label="Previous page"
            >
              &lt; Prev
            </button>

            <div id="pg-numbers-container" class="inline-flex items-center gap-1">
              <button type="button" class="pg-btn pg-num inline-flex items-center justify-center min-w-8 h-8 px-2 rounded-[var(--radius-sm)] font-mono text-[0.78rem] bg-transparent border border-transparent text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-tag-hover)] hover:border-[var(--border-subtle)] cursor-pointer transition-all duration-150 aria-[current=page]:bg-[var(--bg-card)] aria-[current=page]:text-[var(--text-primary)] aria-[current=page]:border-[var(--border-glow)] aria-[current=page]:font-bold" data-page="1" aria-current="page">1</button>
            </div>

            <button
              id="pg-next-btn"
              class="pg-btn inline-flex items-center justify-center min-w-8 h-8 px-2 rounded-[var(--radius-sm)] font-mono text-[0.78rem] bg-transparent border border-transparent text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-tag-hover)] hover:border-[var(--border-subtle)] cursor-pointer transition-all duration-150 disabled:opacity-35 disabled:cursor-not-allowed"
              type="button"
              disabled
              aria-label="Next page"
            >
              Next &gt;
            </button>
          </nav>
          <p id="pg-summary-text" class="font-mono text-xs text-[var(--text-muted)] m-0">
            Showing all {posts.length} posts
          </p>
        </div>

        </div>

        <!-- Dotted Separator before Footer -->
        <div class="separator-dotted-h"></div>
        <Footer />
      </div>
    </main>

    <!-- Spotlight Search Modal -->
    <SearchModal posts={posts} />

    <script is:inline>
      (function () {
        const searchTriggerBtn = document.getElementById('hero-search-trigger-btn');
        if (searchTriggerBtn) {
          searchTriggerBtn.addEventListener('click', () => {
            if (typeof window.openSpotlightSearch === 'function') {
              window.openSpotlightSearch();
            }
          });
        }

        const categoryTabs = document.querySelectorAll('.cat-tab-btn');
        const postCards = Array.from(document.querySelectorAll('[data-post-card]'));
        const featuredGrid = document.getElementById('featured-posts-grid');
        const emptyState = document.getElementById('no-posts-found');
        const resetBtn = document.getElementById('reset-filter-btn');

        const prevBtn = document.getElementById('pg-prev-btn');
        const nextBtn = document.getElementById('pg-next-btn');
        const numbersContainer = document.getElementById('pg-numbers-container');
        const summaryText = document.getElementById('pg-summary-text');

        const PAGE_SIZE = 6;
        let currentCategory = 'All';
        let currentPage = 1;

        function getFilteredPosts() {
          if (currentCategory === 'All') return postCards;
          return postCards.filter((card) => {
            const cat = card.getAttribute('data-category') || '';
            const tags = JSON.parse(card.getAttribute('data-tags') || '[]');
            return cat.toLowerCase() === currentCategory.toLowerCase() || 
                   tags.some(t => t.toLowerCase() === currentCategory.toLowerCase());
          });
        }

        function renderPagination(filteredList) {
          const total = filteredList.length;
          const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
          if (currentPage > totalPages) currentPage = totalPages;

          postCards.forEach((c) => (c.style.display = 'none'));

          if (total === 0) {
            if (emptyState) emptyState.style.display = 'block';
            if (featuredGrid) featuredGrid.style.display = 'none';
          } else {
            if (emptyState) emptyState.style.display = 'none';
            if (featuredGrid) featuredGrid.style.display = 'grid';

            const startIndex = (currentPage - 1) * PAGE_SIZE;
            const endIndex = startIndex + PAGE_SIZE;

            filteredList.slice(startIndex, endIndex).forEach((card) => {
              card.style.display = '';
            });
          }

          if (prevBtn) {
            prevBtn.disabled = currentPage <= 1;
          }
          if (nextBtn) {
            nextBtn.disabled = currentPage >= totalPages;
          }

          if (numbersContainer) {
            numbersContainer.innerHTML = '';
            for (let i = 1; i <= totalPages; i++) {
              const btn = document.createElement('button');
              btn.type = 'button';
              const isActive = i === currentPage;
              btn.className = 'pg-btn pg-num inline-flex items-center justify-center min-w-8 h-8 px-2 rounded-[var(--radius-sm)] font-mono text-[0.78rem] bg-transparent border border-transparent text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-tag-hover)] hover:border-[var(--border-subtle)] cursor-pointer transition-all duration-150 aria-[current=page]:bg-[var(--bg-card)] aria-[current=page]:text-[var(--text-primary)] aria-[current=page]:border-[var(--border-glow)] aria-[current=page]:font-bold';
              if (isActive) {
                btn.setAttribute('aria-current', 'page');
              }
              btn.textContent = String(i);
              btn.setAttribute('data-page', String(i));
              btn.addEventListener('click', () => {
                currentPage = i;
                renderPagination(filteredList);
                scrollToFeed();
              });
              numbersContainer.appendChild(btn);
            }
          }

          if (summaryText) {
            summaryText.textContent = `Showing page ${currentPage} of ${totalPages} · ${total} ${total === 1 ? 'post' : 'posts'}`;
          }
        }

        function scrollToFeed() {
          const feed = document.getElementById('posts-feed-section');
          if (feed) {
            feed.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }

        categoryTabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            categoryTabs.forEach((t) => {
              t.setAttribute('aria-selected', t === tab ? 'true' : 'false');
            });
            currentCategory = tab.getAttribute('data-category') || 'All';
            currentPage = 1;
            renderPagination(getFilteredPosts());
          });
        });

        if (resetBtn) {
          resetBtn.addEventListener('click', () => {
            currentCategory = 'All';
            currentPage = 1;
            categoryTabs.forEach((t) => {
              const isAll = t.getAttribute('data-category') === 'All';
              t.setAttribute('aria-selected', isAll ? 'true' : 'false');
            });
            renderPagination(getFilteredPosts());
          });
        }

        if (prevBtn) {
          prevBtn.addEventListener('click', () => {
            if (currentPage > 1) {
              currentPage--;
              renderPagination(getFilteredPosts());
              scrollToFeed();
            }
          });
        }

        if (nextBtn) {
          nextBtn.addEventListener('click', () => {
            const totalPages = Math.ceil(getFilteredPosts().length / PAGE_SIZE);
            if (currentPage < totalPages) {
              currentPage++;
              renderPagination(getFilteredPosts());
              scrollToFeed();
            }
          });
        }

        renderPagination(getFilteredPosts());
      })();
    </script>
  </body>
</html>
