---
import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import SearchModal from "../components/SearchModal.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { AUTHOR_PORTFOLIO } from "../consts";

const allPosts = await getCollection("blog");
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="404 — Page Not Found | Priyam's Blog"
      description="The page or article you are looking for does not exist on Priyam's Blog."
    />
  </head>
  <body>
    <!-- Background Ambient Glow -->
    <div class="notfound-glow"></div>

    <main class="notfound-main">
      <div class="notfound-container">
        <!-- Top Nav Bar -->
        <header class="notfound-header">
          <a href="/" class="notfound-brand" aria-label="Priyam's Blog Home">
            <img
              src="/logo.png"
              alt="Priyam's Blog"
              class="notfound-logo"
              width="34"
              height="34"
            />
            <span class="notfound-brand-title">Priyam's Blog</span>
          </a>

          <div class="notfound-nav-actions">
            <ThemeToggle />
            <a
              href={AUTHOR_PORTFOLIO}
              class="notfound-nav-btn"
              title="Portfolio Home"
              aria-label="Portfolio Home"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
              </svg>
            </a>
          </div>
        </header>

        <!-- 404 Hero Card -->
        <div class="notfound-card">
          <div class="notfound-badge">
            <span class="pulse-dot"></span>
            <span>404 // ROUTE_NOT_FOUND</span>
          </div>

          <h1 class="notfound-code">404</h1>
          <h2 class="notfound-title">Lost in the Digital Void</h2>
          <p class="notfound-desc">
            The article, route, or resource you are looking for has been moved,
            renamed, or doesn't exist.
          </p>

          <!-- Auto Redirection Bar -->
          <div class="redirect-box" id="redirect-box">
            <div class="redirect-text-row">
              <div class="redirect-msg">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <span
                  >Redirecting to blog home in <strong id="countdown-num"
                    >6</strong
                  >s</span
                >
              </div>
              <button
                id="cancel-redirect-btn"
                class="cancel-redirect-btn"
                type="button"
                aria-label="Stay on page"
              >
                Stay on page
              </button>
            </div>
            <div class="redirect-track">
              <div class="redirect-fill" id="redirect-fill"></div>
            </div>
          </div>

          <!-- Quick Action Buttons -->
          <div class="notfound-actions">
            <a href="/" class="btn-primary" id="home-now-btn">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="m15 18-6-6 6-6"></path>
              </svg>
              <span>Back to Articles</span>
            </a>

            <button id="search-trigger-404" class="btn-secondary" type="button">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.3-4.3"></path>
              </svg>
              <span>Search Articles (Ctrl+K)</span>
            </button>
          </div>
        </div>

        <!-- Suggested Articles -->
        {
          recentPosts.length > 0 && (
            <div class="suggested-section">
              <div class="suggested-header">
                <h3 class="suggested-title">Or explore popular articles:</h3>
              </div>
              <div class="suggested-grid">
                {recentPosts.map((post) => (
                  <a href={`/${post.id}`} class="suggested-card">
                    <div class="suggested-card-body">
                      <h4 class="suggested-post-title">{post.data.title}</h4>
                      <p class="suggested-post-desc">{post.data.description}</p>
                      <div class="suggested-meta">
                        <span class="suggested-date">
                          <FormattedDate date={post.data.pubDate} />
                        </span>
                        {post.data.tags && post.data.tags.length > 0 && (
                          <span class="suggested-tag">
                            #{post.data.tags[0]}
                          </span>
                        )}
                      </div>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )
        }
      </div>
    </main>

    <SearchModal posts={allPosts} />
    <Footer />
  </body>
</html>

<style>
  .notfound-main {
    min-height: 90vh;
    padding: 2rem 1rem 5rem;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .notfound-container {
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .notfound-glow {
    position: fixed;
    top: 15%;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 350px;
    background: radial-gradient(
      circle,
      rgba(59, 130, 246, 0.08) 0%,
      rgba(234, 179, 8, 0.04) 50%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
    filter: blur(60px);
  }

  /* Header */
  .notfound-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding-bottom: 1.5rem;
    border-bottom: 1px dashed var(--border-subtle);
  }

  .notfound-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--text-primary);
  }

  .notfound-logo {
    width: 32px;
    height: 32px;
    object-fit: contain;
    transition: transform 0.2s ease;
  }

  .notfound-brand:hover .notfound-logo {
    transform: scale(1.08);
  }

  .notfound-brand-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }

  .notfound-nav-actions {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .notfound-nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    background: transparent;
    transition: all 0.15s ease;
    text-decoration: none;
  }

  .notfound-nav-btn:hover {
    color: var(--text-primary);
    background: var(--bg-hover);
    border-color: var(--border-hover);
  }

  /* Hero Card */
  .notfound-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    padding: 3rem 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-shadow: 0 4px 24px -4px rgba(0, 0, 0, 0.1);
    position: relative;
    overflow: hidden;
  }

  .notfound-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 0.3rem 0.75rem;
    border-radius: 9999px;
    background: rgba(239, 68, 68, 0.1);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.25);
    margin-bottom: 1.25rem;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #ef4444;
    box-shadow: 0 0 8px #ef4444;
    animation: pulse 1.8s infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.4;
      transform: scale(0.85);
    }
  }

  .notfound-code {
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 12vw, 7.5rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.04em;
    background: linear-gradient(
      180deg,
      var(--text-primary) 30%,
      var(--text-muted) 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin: 0 0 0.5rem;
  }

  .notfound-title {
    font-size: clamp(1.25rem, 3.5vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    margin: 0 0 0.75rem;
  }

  .notfound-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 520px;
    margin: 0 0 2rem;
  }

  /* Redirection bar */
  .redirect-box {
    width: 100%;
    max-width: 440px;
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    padding: 0.75rem 1rem;
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .redirect-text-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-family: var(--font-mono);
  }

  .redirect-msg {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-secondary);
  }

  .redirect-msg strong {
    color: var(--accent-primary);
    font-weight: 700;
  }

  .cancel-redirect-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: 0.72rem;
    font-family: var(--font-mono);
    text-decoration: underline;
    cursor: pointer;
    padding: 0.1rem 0.3rem;
    transition: color 0.15s ease;
  }

  .cancel-redirect-btn:hover {
    color: var(--text-primary);
  }

  .redirect-track {
    width: 100%;
    height: 4px;
    background: var(--bg-hover);
    border-radius: 9999px;
    overflow: hidden;
  }

  .redirect-fill {
    width: 100%;
    height: 100%;
    background: var(--accent-primary);
    border-radius: 9999px;
    transition: width 0.1s linear;
  }

  /* Action Buttons */
  .notfound-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    width: 100%;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.25rem;
    background: var(--text-primary);
    color: var(--bg-primary);
    font-weight: 600;
    font-size: 0.88rem;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .btn-primary:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.2rem;
    background: transparent;
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
    font-weight: 600;
    font-size: 0.88rem;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-secondary:hover {
    background: var(--bg-hover);
    border-color: var(--border-hover);
    transform: translateY(-1px);
  }

  /* Suggested Articles */
  .suggested-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1rem;
  }

  .suggested-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .suggested-title {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    margin: 0;
  }

  .suggested-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
  }

  @media (min-width: 640px) {
    .suggested-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .suggested-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    padding: 1rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .suggested-card:hover {
    border-color: var(--border-hover);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
  }

  .suggested-card-body {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .suggested-post-title {
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--text-primary);
    margin: 0 0 0.4rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .suggested-post-desc {
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--text-muted);
    margin: 0 0 0.85rem;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .suggested-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
    padding-top: 0.5rem;
    border-top: 1px dashed var(--border-subtle);
  }

  .suggested-tag {
    color: var(--accent-primary);
  }
</style>

<script is:inline>
  (function () {
    // 404 Spotlight Search Trigger
    const searchBtn = document.getElementById("search-trigger-404");
    if (searchBtn) {
      searchBtn.addEventListener("click", () => {
        if (typeof window.openSpotlightSearch === "function") {
          window.openSpotlightSearch();
        }
      });
    }

    // Auto-Redirect Countdown Logic (6 seconds)
    const TOTAL_SECONDS = 6;
    let remaining = TOTAL_SECONDS;
    let isCancelled = false;

    const countdownNum = document.getElementById("countdown-num");
    const redirectFill = document.getElementById("redirect-fill");
    const cancelBtn = document.getElementById("cancel-redirect-btn");
    const redirectBox = document.getElementById("redirect-box");

    const interval = setInterval(() => {
      if (isCancelled) {
        clearInterval(interval);
        return;
      }

      remaining -= 0.1;
      if (remaining <= 0) {
        clearInterval(interval);
        window.location.href = "/";
        return;
      }

      if (countdownNum) {
        countdownNum.textContent = Math.ceil(remaining).toString();
      }

      if (redirectFill) {
        const pct = (remaining / TOTAL_SECONDS) * 100;
        redirectFill.style.width = `${pct}%`;
      }
    }, 100);

    if (cancelBtn) {
      cancelBtn.addEventListener("click", () => {
        isCancelled = true;
        clearInterval(interval);
        if (redirectBox) {
          redirectBox.innerHTML = `
            <div style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-muted); text-align: center;">
              Auto-redirection cancelled. Feel free to explore the articles below.
            </div>
          `;
        }
      });
    }
  })();
</script>
