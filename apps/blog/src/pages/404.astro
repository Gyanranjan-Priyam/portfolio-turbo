---
import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import SearchModal from "../components/SearchModal.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import FormattedDate from "../components/FormattedDate.astro";
import HatchDivider from "../components/HatchDivider.astro";
import { AUTHOR_PORTFOLIO } from "../consts";

import placeholder2 from "../assets/blog-placeholder-2.jpg";
import placeholder3 from "../assets/blog-placeholder-3.jpg";
import placeholder4 from "../assets/blog-placeholder-4.jpg";
import placeholder5 from "../assets/blog-placeholder-5.jpg";

const placeholders = [placeholder2, placeholder3, placeholder4, placeholder5];

const getPlaceholderImage = (id: string) => {
  let hash = 0;
  for (let i = 0; i < id.length; i++) {
    hash = (hash << 5) - hash + id.charCodeAt(i);
    hash |= 0;
  }
  return placeholders[Math.abs(hash) % placeholders.length].src;
};

const allPosts = await getCollection("blog");
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

// Color mapping helper for category badges
const getCategoryColorClass = (cat: string) => {
  const c = cat.toLowerCase();
  if (c.includes('engineering') || c.includes('tech')) return 'text-sky-600 dark:text-sky-400 [&_.cat-bar]:bg-sky-600 dark:[&_.cat-bar]:bg-sky-400';
  if (c.includes('career') || c.includes('journey')) return 'text-orange-600 dark:text-orange-400 [&_.cat-bar]:bg-orange-600 dark:[&_.cat-bar]:bg-orange-400';
  if (c.includes('web') || c.includes('dev')) return 'text-purple-600 dark:text-purple-400 [&_.cat-bar]:bg-purple-600 dark:[&_.cat-bar]:bg-purple-400';
  if (c.includes('guide') || c.includes('tutorial')) return 'text-green-600 dark:text-green-400 [&_.cat-bar]:bg-green-600 dark:[&_.cat-bar]:bg-green-400';
  return 'text-rose-600 dark:text-rose-400 [&_.cat-bar]:bg-rose-600 dark:[&_.cat-bar]:bg-rose-400';
};
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="404 — Page Not Found | Priyam's Blog"
      description="The page or article you are looking for does not exist on Priyam's Blog."
    />
  </head>
  <body class="bg-[var(--bg-primary)] text-[var(--text-primary)] min-h-screen flex flex-col font-sans">
    <main class="min-h-screen p-0 bg-[var(--bg-primary)] w-full flex flex-col">
      <div class="max-w-[1080px] mx-auto w-full px-5 sm:px-9 pt-8 pb-18 min-h-screen flex flex-col border-dotted-side">
        <div class="flex-1 flex flex-col w-full">
          
          <!-- MINIMAL TOP BAR -->
          <header class="flex items-center justify-between pb-2 w-full">
            <a href="/" class="group inline-flex items-center gap-2.5 text-inherit no-underline text-[var(--text-primary)]" aria-label="Priyam's Blog Home">
              <img src="/logo.png" alt="Logo" class="w-7 h-7 object-contain group-hover:scale-105 transition-transform duration-200" width="28" height="28" />
              <span class="font-display font-bold text-[0.95rem] tracking-tight text-[var(--text-primary)]">Priyam's Blog</span>
            </a>

            <div class="flex items-center gap-2">
              <!-- Theme Toggle -->
              <ThemeToggle />

              <!-- Portfolio Link -->
              <a
                href={AUTHOR_PORTFOLIO}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[var(--bg-tag)] hover:bg-[var(--bg-tag-hover)] border border-[var(--border-subtle)] hover:border-[var(--border-glow)] font-sans text-[0.8rem] font-medium text-[var(--text-secondary)] hover:text-[var(--text-primary)] no-underline cursor-pointer transition-all duration-150"
              >
                <span>Portfolio</span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M7 17L17 7M17 7H7M17 7V17" />
                </svg>
              </a>
            </div>
          </header>

          <!-- Hatch Pattern Separator below Top Bar -->
          <HatchDivider class="!mt-0 !mb-7" />

          <!-- 404 HERO SECTION -->
          <section class="flex flex-col items-center text-center my-2 mb-8 w-full">
            <div class="inline-flex items-center gap-2 font-mono text-[0.74rem] font-semibold tracking-wide px-3 py-1 rounded-full bg-red-500/10 text-red-500 border border-red-500/25 mb-4">
              <span class="w-1.5 h-1.5 rounded-full bg-red-500 shadow-[0_0_8px_#ef4444] animate-pulse"></span>
              <span>404 // ROUTE_NOT_FOUND</span>
            </div>

            <h1 class="font-display text-6xl sm:text-7xl md:text-8xl font-black leading-none tracking-tighter bg-gradient-to-b from-[var(--text-primary)] to-[var(--text-muted)] bg-clip-text text-transparent my-2 mb-2">
              404
            </h1>
            <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[var(--text-primary)] mb-2.5">
              Lost in the Digital Void
            </h2>
            <p class="font-sans text-sm sm:text-base leading-relaxed text-[var(--text-secondary)] max-w-[500px] mx-auto mb-7">
              The article, route, or resource you are looking for has been moved, renamed, or doesn't exist.
            </p>

            <!-- Auto Redirection Bar -->
            <div class="w-full max-w-[440px] mx-auto bg-[var(--bg-card)] border border-[var(--border-subtle)] rounded-xl p-3 px-4 mb-7 flex flex-col gap-2 shadow-[var(--shadow-sm)]" id="redirect-box">
              <div class="flex items-center justify-between gap-2 text-xs font-mono">
                <div class="flex items-center gap-1.5 text-[var(--text-secondary)]">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                  <span>Redirecting to blog home in <strong id="countdown-num" class="text-[var(--text-primary)] font-bold">6</strong>s</span>
                </div>
                <button
                  id="cancel-redirect-btn"
                  class="bg-transparent border-none text-[var(--text-muted)] hover:text-[var(--text-primary)] text-[0.72rem] font-mono underline cursor-pointer p-0.5 transition-colors"
                  type="button"
                  aria-label="Stay on page"
                >
                  Stay on page
                </button>
              </div>
              <div class="w-full h-1 bg-[var(--bg-tag)] rounded-full overflow-hidden">
                <div class="h-full w-full bg-[var(--accent-primary)] rounded-full transition-[width] duration-100 linear" id="redirect-fill"></div>
              </div>
            </div>

            <!-- Quick Action Buttons -->
            <div class="flex items-center justify-center gap-3 flex-wrap w-full">
              <a
                href="/"
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[var(--text-primary)] text-[var(--text-inverted)] font-sans text-xs sm:text-sm font-semibold no-underline hover:opacity-90 hover:-translate-y-0.5 transition-all duration-150 cursor-pointer shadow-[var(--shadow-sm)]"
                id="home-now-btn"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="m15 18-6-6 6-6"></path>
                </svg>
                <span>Back to Articles</span>
              </a>

              <button
                id="search-trigger-404"
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[var(--bg-card)] hover:bg-[var(--bg-card-hover)] border border-[var(--border-subtle)] hover:border-[var(--border-glow)] text-[var(--text-primary)] font-sans text-xs sm:text-sm font-semibold cursor-pointer hover:-translate-y-0.5 transition-all duration-150 shadow-[var(--shadow-sm)]"
                type="button"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="11" cy="11" r="8"></circle>
                  <path d="m21 21-4.3-4.3"></path>
                </svg>
                <span>Search Articles (Ctrl+K)</span>
              </button>
            </div>
          </section>

          <!-- Hatch Pattern Separator between Hero and Suggested Articles -->
          <HatchDivider class="!mt-0 !mb-10" />

          <!-- SUGGESTED ARTICLES FEED -->
          {recentPosts.length > 0 && (
            <section class="w-full">
              <div class="flex items-center justify-between mb-6">
                <h3 class="font-mono text-xs font-bold uppercase tracking-wider text-[var(--text-muted)] m-0">
                  Recommended Articles
                </h3>
                <a href="/" class="font-mono text-xs text-[var(--text-secondary)] hover:text-[var(--text-primary)] no-underline">
                  View all posts &rarr;
                </a>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-7 mb-10 w-full">
                {recentPosts.map((post) => {
                  const imageSrc = post.data.heroImage
                    ? typeof post.data.heroImage === 'string'
                      ? post.data.heroImage
                      : post.data.heroImage.src
                    : null;
                  const cat = post.data.category || 'Engineering';
                  const colorClass = getCategoryColorClass(cat);
                  const fallbackBg = getPlaceholderImage(post.id);

                  return (
                    <article class="group flex flex-col rounded-[var(--radius-lg)] w-full">
                      <a href={`/${post.id}`} class="flex flex-col h-full no-underline text-inherit" aria-label={post.data.title}>
                        <!-- Visual Cover / Thumbnail -->
                        <div class="relative w-full aspect-video rounded-[var(--radius-md)] overflow-hidden border border-[var(--border-subtle)] group-hover:border-[var(--border-glow)] mb-3.5 transition-all duration-200">
                          {imageSrc ? (
                            <img
                              src={imageSrc}
                              alt={post.data.title}
                              loading="lazy"
                              class="w-full h-full object-cover object-center block"
                            />
                          ) : (
                            <div class="relative w-full h-full aspect-video flex flex-col items-center justify-center p-5 overflow-hidden text-center bg-[#0c0d12]">
                              <img src={fallbackBg} alt="" class="absolute inset-0 w-full h-full object-cover z-1 opacity-90 brightness-85 contrast-110 group-hover:scale-105 transition-transform duration-350" aria-hidden="true" />
                              <div class="absolute inset-0 z-2 pointer-events-none bg-[radial-gradient(circle_at_center,rgba(12,13,18,0.45)_0%,rgba(8,8,12,0.88)_100%)]"></div>
                              <div class="relative z-3 flex flex-col items-center justify-center gap-1.5 max-w-[90%]">
                                <div class="inline-flex items-center gap-1.5 font-mono text-[0.62rem] font-bold tracking-[0.14em] uppercase text-white/85 drop-shadow-md">
                                  <span class="text-[0.7rem] text-yellow-300">✦</span>
                                  <span>{post.data.category || 'BLOG'}</span>
                                </div>
                                <h3 class="font-serif text-base sm:text-lg font-semibold leading-snug text-white tracking-tight line-clamp-2 drop-shadow-lg m-0">{post.data.title}</h3>
                                {post.data.description && (
                                  <p class="font-sans text-[0.72rem] text-white/70 line-clamp-1 max-w-[90%] m-0 drop-shadow">{post.data.description}</p>
                                )}
                              </div>
                            </div>
                          )}
                          <div class="absolute top-2.5 left-2.5 inline-flex items-center gap-1 px-2 py-0.5 bg-[rgba(10,10,12,0.75)] backdrop-blur-md border border-white/15 rounded-[var(--radius-sm)] font-mono text-[0.68rem] font-medium text-slate-100">
                            <span class="text-[0.55rem] opacity-85">▶</span>
                            <span>{post.data.readingTime || '5 min read'}</span>
                          </div>
                        </div>

                        <!-- Post Info -->
                        <div class="flex flex-col flex-1">
                          <div class={`inline-flex items-center gap-1.5 font-mono text-[0.68rem] font-bold tracking-wider uppercase mb-1.5 ${colorClass}`}>
                            <span class="cat-bar inline-block w-[3px] h-2.5 rounded-xs"></span>
                            <span>{cat}</span>
                          </div>

                          <h2 class="font-display text-[1.15rem] font-bold leading-snug tracking-tight text-[var(--text-primary)] mb-1.5 group-hover:text-[var(--accent-primary)] transition-colors duration-150 line-clamp-2 min-h-[2.7em]">
                            {post.data.title}
                          </h2>

                          <p class="font-sans text-[0.85rem] leading-relaxed text-[var(--text-secondary)] mb-3 line-clamp-2 min-h-[3.1em]">
                            {post.data.description}
                          </p>

                          <div class="flex items-center gap-1.5 font-mono text-xs text-[var(--text-muted)] mt-auto">
                            <span>
                              <FormattedDate date={post.data.pubDate} />
                            </span>
                            <span class="opacity-50">·</span>
                            <span>{post.data.readingTime || '5 min read'}</span>
                          </div>
                        </div>
                      </a>
                    </article>
                  );
                })}
              </div>
            </section>
          )}

        </div>

        <!-- Dotted Separator before Footer -->
        <div class="separator-dotted-h"></div>
        <Footer />
      </div>
    </main>

    <SearchModal posts={allPosts} />

    <script is:inline>
      (function () {
        const searchBtn = document.getElementById("search-trigger-404");
        if (searchBtn) {
          searchBtn.addEventListener("click", () => {
            if (typeof window.openSpotlightSearch === "function") {
              window.openSpotlightSearch();
            }
          });
        }

        const TOTAL_SECONDS = 6;
        let remaining = TOTAL_SECONDS;
        let isCancelled = false;

        const countdownNum = document.getElementById("countdown-num");
        const redirectFill = document.getElementById("redirect-fill");
        const cancelBtn = document.getElementById("cancel-redirect-btn");
        const redirectBox = document.getElementById("redirect-box");

        const interval = setInterval(() => {
          if (isCancelled) {
            clearInterval(interval);
            return;
          }

          remaining -= 0.1;
          if (remaining <= 0) {
            clearInterval(interval);
            window.location.href = "/";
            return;
          }

          if (countdownNum) {
            countdownNum.textContent = Math.ceil(remaining).toString();
          }

          if (redirectFill) {
            const pct = (remaining / TOTAL_SECONDS) * 100;
            redirectFill.style.width = `${pct}%`;
          }
        }, 100);

        if (cancelBtn) {
          cancelBtn.addEventListener("click", () => {
            isCancelled = true;
            clearInterval(interval);
            if (redirectBox) {
              redirectBox.innerHTML = `
                <div class="font-mono text-xs text-[var(--text-muted)] text-center py-1">
                  Auto-redirection cancelled. Feel free to explore the articles below.
                </div>
              `;
            }
          });
        }
      })();
    </script>
  </body>
</html>
