---
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import SearchModal from "../../components/SearchModal.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import { AUTHOR_PORTFOLIO } from "../../consts";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");
  const uniqueTags = [
    ...new Set(allPosts.flatMap((post) => post.data.tags || [])),
  ];

  return uniqueTags.map((tag) => {
    const filteredPosts = allPosts
      .filter((post) => post.data.tags?.includes(tag))
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
    return {
      params: { tag },
      props: { posts: filteredPosts, allPosts },
    };
  });
}

const { tag } = Astro.params;
const { posts, allPosts = [] } = Astro.props;

// Get other popular tags for quick navigation
const tagCounts: Record<string, number> = {};
allPosts.forEach((post) => {
  post.data.tags?.forEach((t) => {
    tagCounts[t] = (tagCounts[t] || 0) + 1;
  });
});
const otherPopularTags = Object.entries(tagCounts)
  .filter(([t]) => t !== tag)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 4)
  .map(([t]) => t);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Articles tagged #${tag} | Priyam's Blog`}
      description={`Articles, engineering notes, and technical deep dives tagged #${tag}.`}
    />
  </head>
  <body>
    <main class="blogs-page-main">
      <div id="blogs-page-wrap" class="blogs-page-wrap">
        <!-- Header -->
        <header class="blogs-header">
          <div class="blogs-header-top-row">
            <div class="blogs-brand-group">
              <a href="/" class="blogs-brand-logo-link" aria-label="Home">
                <img
                  src="/logo.png"
                  alt="Priyam's Blog"
                  class="blogs-brand-logo"
                  width="40"
                  height="40"
                />
              </a>
              <a href="/" class="blogs-title-link">
                <h1 class="blogs-title">Priyam's Blog</h1>
              </a>
            </div>

            <!-- Controls (Search, View Mode, Theme Toggle, Home) -->
            <div class="blogs-controls">
              <!-- Search -->
              <button
                id="search-trigger-btn"
                class="icon-btn search-trigger"
                aria-label="Search posts"
                title="Search posts (Ctrl+K)"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="11" cy="11" r="8"></circle>
                  <path d="m21 21-4.3-4.3"></path>
                </svg>
              </button>

              <!-- View Mode Toggle -->
              <button
                id="view-toggle-btn"
                class="icon-btn view-toggle"
                aria-label="Toggle layout view mode"
                title="Toggle layout view mode"
              >
                <svg
                  id="list-icon"
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <line x1="8" y1="6" x2="21" y2="6"></line>
                  <line x1="8" y1="12" x2="21" y2="12"></line>
                  <line x1="8" y1="18" x2="21" y2="18"></line>
                  <line x1="3" y1="6" x2="3.01" y2="6"></line>
                  <line x1="3" y1="12" x2="3.01" y2="12"></line>
                  <line x1="3" y1="18" x2="3.01" y2="18"></line>
                </svg>
                <svg
                  id="grid-icon"
                  style="display: none;"
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="3" y="3" width="7" height="7"></rect>
                  <rect x="14" y="3" width="7" height="7"></rect>
                  <rect x="14" y="14" width="7" height="7"></rect>
                  <rect x="3" y="14" width="7" height="7"></rect>
                </svg>
              </button>

              <!-- Theme Toggle -->
              <button
                id="theme-toggle-btn"
                class="icon-btn theme-toggle"
                aria-label="Toggle dark/light theme"
                title="Toggle dark/light theme"
              >
                <svg
                  id="theme-moon"
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
                </svg>
                <svg
                  id="theme-sun"
                  style="display: none;"
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="12" cy="12" r="4"></circle>
                  <path d="M12 2v2"></path>
                  <path d="M12 20v2"></path>
                  <path d="m4.93 4.93 1.41 1.41"></path>
                  <path d="m17.66 17.66 1.41 1.41"></path>
                  <path d="M2 12h2"></path>
                  <path d="M20 12h2"></path>
                  <path d="m6.34 17.66-1.41 1.41"></path>
                  <path d="m19.07 4.93-1.41 1.41"></path>
                </svg>
              </button>

              <!-- Home -->
              <a
                href={AUTHOR_PORTFOLIO}
                class="icon-btn"
                aria-label="Home"
                title="Portfolio Home"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"
                  ></path>
                  <polyline points="9 22 9 12 15 12 15 22"></polyline>
                </svg>
              </a>
            </div>
          </div>

          <!-- Tag Header Banner -->
          <div class="tag-banner">
            <a href="/" class="back-link">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg
              >
              All Articles
            </a>
            <div class="tag-banner-title-row">
              <h2 class="tag-heading">
                Articles tagged <span class="tag-highlight">#{tag}</span>
              </h2>
              <span class="tag-count-badge"
                >{posts.length}
                {posts.length === 1 ? "article" : "articles"}</span
              >
            </div>

            {
              otherPopularTags.length > 0 && (
                <div class="other-tags-row">
                  <span class="other-tags-label">Other tags:</span>
                  <div class="other-tags-chips">
                    {otherPopularTags.map((t) => (
                      <a
                        href={`/tags/${encodeURIComponent(t)}`}
                        class="other-tag-chip"
                      >
                        #{t}
                      </a>
                    ))}
                  </div>
                </div>
              )
            }
          </div>
        </header>

        <!-- Blog Posts List / Tiles -->
        <div id="blogs-container" class="blogs-list-mode">
          {
            posts.map((post) => (
              <a href={`/${post.id}`} class="blog-entry-card">
                {post.data.heroImage && (
                  <div class="blog-entry-image">
                    <img
                      src={
                        typeof post.data.heroImage === "string"
                          ? post.data.heroImage
                          : post.data.heroImage.src
                      }
                      alt={post.data.title}
                      loading="lazy"
                    />
                  </div>
                )}
                <div class="blog-entry-content">
                  <div class="blog-entry-top">
                    <h3 class="blog-entry-title">{post.data.title}</h3>
                    <span class="blog-entry-date">
                      <FormattedDate date={post.data.pubDate} />
                    </span>
                  </div>
                  <p class="blog-entry-desc">{post.data.description}</p>
                  {post.data.tags && post.data.tags.length > 0 && (
                    <div class="blog-entry-tags">
                      {post.data.tags.slice(0, 3).map((t) => (
                        <span
                          class={`blog-tag-pill ${t === tag ? "active-tag" : ""}`}
                        >
                          #{t}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </main>

    <!-- Search Modal -->
    <SearchModal posts={allPosts.length > 0 ? allPosts : posts} />
    <Footer />

    <script is:inline>
      (function () {
        const wrap = document.getElementById("blogs-page-wrap");
        const container = document.getElementById("blogs-container");
        const toggleBtn = document.getElementById("view-toggle-btn");
        const listIcon = document.getElementById("list-icon");
        const gridIcon = document.getElementById("grid-icon");
        const searchBtn = document.getElementById("search-trigger-btn");
        const themeBtn = document.getElementById("theme-toggle-btn");
        const moonIcon = document.getElementById("theme-moon");
        const sunIcon = document.getElementById("theme-sun");

        // Search trigger
        if (searchBtn) {
          searchBtn.addEventListener("click", () => {
            if (typeof window.openSpotlightSearch === "function") {
              window.openSpotlightSearch();
            }
          });
        }

        // View Mode Toggle (List vs Tiles) with localStorage
        let currentMode = localStorage.getItem("blogs_view_mode") || "list";
        renderMode(currentMode);

        function renderMode(mode) {
          if (!wrap || !container) return;

          if (mode === "tiles") {
            wrap.classList.add("tiles-mode");
            container.className = "blogs-tiles-mode";
            if (listIcon) listIcon.style.display = "block";
            if (gridIcon) gridIcon.style.display = "none";
            toggleBtn?.setAttribute("title", "Switch to list view");
            localStorage.setItem("blogs_view_mode", "tiles");
            currentMode = "tiles";
          } else {
            wrap.classList.remove("tiles-mode");
            container.className = "blogs-list-mode";
            if (listIcon) listIcon.style.display = "none";
            if (gridIcon) gridIcon.style.display = "block";
            toggleBtn?.setAttribute("title", "Switch to tiles view");
            localStorage.setItem("blogs_view_mode", "list");
            currentMode = "list";
          }
        }

        if (toggleBtn) {
          toggleBtn.addEventListener("click", () => {
            const next = currentMode === "list" ? "tiles" : "list";
            renderMode(next);
          });
        }

        // Theme Toggle
        function updateThemeIcons(theme) {
          if (theme === "dark") {
            if (moonIcon) moonIcon.style.display = "none";
            if (sunIcon) sunIcon.style.display = "block";
          } else {
            if (moonIcon) moonIcon.style.display = "block";
            if (sunIcon) sunIcon.style.display = "none";
          }
        }

        const isDark =
          document.documentElement.classList.contains("dark") ||
          (!("theme" in localStorage) &&
            window.matchMedia("(prefers-color-scheme: dark)").matches) ||
          localStorage.getItem("theme") === "dark";

        updateThemeIcons(isDark ? "dark" : "light");

        if (themeBtn) {
          themeBtn.addEventListener("click", () => {
            const currentIsDark =
              document.documentElement.classList.contains("dark");
            const newTheme = currentIsDark ? "light" : "dark";
            if (newTheme === "dark") {
              document.documentElement.classList.add("dark");
            } else {
              document.documentElement.classList.remove("dark");
            }
            localStorage.setItem("theme", newTheme);
            updateThemeIcons(newTheme);
          });
        }
      })();
    </script>
  </body>
</html>

<style>
  .blogs-page-main {
    flex: 1;
    min-height: 100vh;
    padding: 2.5rem 1rem 5rem;
    background-color: var(--bg-primary);
    color: var(--text-primary);
  }

  .blogs-page-wrap {
    max-width: 680px;
    margin: 0 auto;
    transition: max-width 0.25s ease;
  }

  .blogs-page-wrap.tiles-mode {
    max-width: 980px;
  }

  /* ── Header ── */
  .blogs-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .blogs-header-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
  }

  .blogs-brand-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .blogs-brand-logo-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    text-decoration: none;
  }

  .blogs-brand-logo {
    width: 38px;
    height: 38px;
    object-fit: contain;
    display: block;
    transition: transform 0.2s ease;
  }

  .blogs-brand-logo-link:hover .blogs-brand-logo {
    transform: scale(1.05);
  }

  .blogs-title-link {
    text-decoration: none;
    color: inherit;
  }

  .blogs-title {
    font-size: 1.65rem;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (min-width: 640px) {
    .blogs-brand-logo {
      width: 44px;
      height: 44px;
    }
    .blogs-title {
      font-size: 2.15rem;
    }
  }

  .blogs-controls {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-shrink: 0;
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: transparent;
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    cursor: pointer;
    text-decoration: none;
    transition: all 0.15s ease;
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .icon-btn {
      width: 30px;
      height: 30px;
    }
    .icon-btn svg {
      width: 14px;
      height: 14px;
    }
  }

  .icon-btn:hover {
    color: var(--text-primary);
    border-color: var(--border-hover);
    background: var(--bg-hover);
  }

  /* ── Tag Banner ── */
  .tag-banner {
    padding: 1.15rem 1.35rem;
    border-radius: 12px;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    box-shadow: var(--shadow-sm);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s ease;
    width: fit-content;
  }

  .back-link:hover {
    color: var(--accent-primary);
  }

  .tag-banner-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .tag-heading {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }

  .tag-highlight {
    font-family: var(--font-mono);
    color: var(--accent-primary);
  }

  .tag-count-badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    background: var(--bg-tag);
    border: 1px solid var(--border-subtle);
    padding: 0.15rem 0.55rem;
    border-radius: 9999px;
  }

  .other-tags-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 0.25rem;
    padding-top: 0.65rem;
    border-top: 1px dashed var(--border-subtle);
  }

  .other-tags-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .other-tags-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .other-tag-chip {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--text-secondary);
    background: var(--bg-tag);
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    padding: 0.15rem 0.55rem;
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: all 0.2s ease;
  }

  .other-tag-chip:hover {
    color: var(--accent-primary);
    border-color: var(--accent-primary);
    background: var(--bg-card);
    transform: translateY(-1px);
  }

  /* ── LIST MODE (Default) ── */
  .blogs-list-mode {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .blog-entry-card {
    display: block;
    text-decoration: none;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    padding: 1.25rem 1.4rem;
    box-shadow: var(--shadow-sm);
    transition: all 0.15s ease;
  }

  .blog-entry-card:hover {
    background: var(--bg-card-hover);
    border-color: var(--border-glow);
  }

  /* In list mode, images are hidden */
  .blogs-list-mode .blog-entry-image {
    display: none !important;
  }

  .blog-entry-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.45rem;
  }

  .blog-entry-title {
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--text-primary);
    margin: 0;
    letter-spacing: -0.01em;
    transition: color 0.15s ease;
  }

  .blog-entry-card:hover .blog-entry-title {
    text-decoration: underline;
  }

  .blog-entry-date {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .blog-entry-desc {
    font-family: var(--font-mono);
    font-size: 0.825rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0 0 0.85rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-entry-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .blog-tag-pill {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-secondary);
    background: var(--bg-tag);
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    padding: 0.15rem 0.5rem;
    letter-spacing: 0.02em;
  }

  .blog-tag-pill.active-tag {
    color: var(--accent-primary);
    border-color: var(--accent-primary);
    background: var(--bg-tag-hover, var(--bg-card));
    font-weight: 600;
  }

  /* ── TILES / GRID MODE ── */
  .blogs-tiles-mode {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .blogs-tiles-mode {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .blogs-tiles-mode .blog-entry-card {
    display: flex;
    flex-direction: column;
    padding: 1.15rem;
  }

  .blogs-tiles-mode .blog-entry-image {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 1rem;
    border: 1px solid var(--border-subtle);
    background: #000;
  }

  .blogs-tiles-mode .blog-entry-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .blogs-tiles-mode .blog-entry-content {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .blogs-tiles-mode .blog-entry-top {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.3rem;
  }

  .blogs-tiles-mode .blog-entry-title {
    font-size: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blogs-tiles-mode .blog-entry-desc {
    flex: 1;
    -webkit-line-clamp: 3;
  }
</style>
