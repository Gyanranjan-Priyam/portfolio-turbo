---
import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { AUTHOR_PORTFOLIO } from "../consts";

const allPosts = await getCollection("blog");
const cachedSamplePosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Offline Mode & Byte Runner Game | Priyam's Blog"
      description="You are currently in offline mode. Enjoy the Byte Runner arcade game while offline!"
    />
  </head>
  <body>
    <!-- Background Glow -->
    <div class="offline-glow"></div>

    <main class="offline-main">
      <div class="offline-container">
        <!-- Top Nav Bar -->
        <header class="offline-header">
          <a href="/" class="offline-brand" aria-label="Priyam's Blog Home">
            <img
              src="/logo.png"
              alt="Priyam's Blog"
              class="offline-logo"
              width="34"
              height="34"
            />
            <span class="offline-brand-title">Priyam's Blog</span>
          </a>

          <div class="offline-nav-actions">
            <ThemeToggle />
            <a
              href={AUTHOR_PORTFOLIO}
              class="offline-nav-btn"
              title="Portfolio Home"
              aria-label="Portfolio Home"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
              </svg>
            </a>
          </div>
        </header>

        <!-- Status Header Banner -->
        <div class="offline-status-banner">
          <div class="status-left">
            <span class="offline-pulse-dot"></span>
            <span class="status-title">OFFLINE MODE ACTIVE</span>
          </div>
          <div class="status-right">
            <button
              id="check-connection-btn"
              class="status-retry-btn"
              type="button"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="13"
                height="13"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"
                ></path>
                <path d="M3 3v5h5"></path>
                <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"
                ></path>
                <path d="M16 16h5v5"></path>
              </svg>
              <span>Reconnect</span>
            </button>
          </div>
        </div>

        <!-- 🕹️ ARCADE GAME CONTAINER -->
        <section
          class="game-wrapper"
          aria-label="Byte Runner Offline Mini-Game"
        >
          <div class="game-header-bar">
            <div class="game-title-group">
              <span class="game-badge">🕹️ MINI-GAME</span>
              <h2 class="game-title">BYTE RUNNER</h2>
            </div>

            <div class="game-stats-bar">
              <div class="stat-item">
                <span class="stat-label">HI</span>
                <span class="stat-value" id="game-highscore">0000</span>
              </div>
              <div class="stat-item active">
                <span class="stat-label">SCORE</span>
                <span class="stat-value" id="game-score">0000</span>
              </div>
              <button
                id="game-sound-toggle"
                class="sound-toggle-btn"
                type="button"
                aria-label="Toggle sound"
              >
                <span id="sound-icon">🔊</span>
              </button>
            </div>
          </div>

          <!-- Canvas Display Frame -->
          <div class="canvas-frame" id="canvas-container">
            <canvas id="runner-canvas" width="680" height="240"></canvas>

            <!-- Start / Game Over Overlay Screen -->
            <div id="game-overlay" class="game-overlay">
              <div class="overlay-content">
                <div class="overlay-icon">⚡</div>
                <h3 id="overlay-title" class="overlay-title">BYTE RUNNER</h3>
                <p id="overlay-subtitle" class="overlay-subtitle">
                  Jump over 404 Firewalls & collect energy bytes!
                </p>
                <div class="overlay-keys">
                  <span class="key-pill">SPACE</span>
                  <span class="key-label">or</span>
                  <span class="key-pill">TAP</span>
                  <span class="key-label">to Jump (Double Jump supported!)</span
                  >
                </div>
                <button id="start-play-btn" class="play-btn" type="button">
                  <span>PLAY NOW</span>
                </button>
              </div>
            </div>
          </div>

          <!-- Mobile Controls Row -->
          <div class="mobile-controls-row">
            <button
              id="mobile-jump-btn"
              class="mobile-action-btn"
              type="button"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="m18 15-6-6-6 6"></path>
              </svg>
              <span>TAP TO JUMP</span>
            </button>
          </div>
        </section>

        <!-- Cached Reading Options -->
        <div class="cached-section">
          <div class="cached-header">
            <div class="cached-header-left">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"
                ></path>
                <path d="M6 6h10"></path>
                <path d="M6 10h10"></path>
              </svg>
              <h3 class="cached-title">Cached Articles Ready to Read</h3>
            </div>
            <a href="/" class="cached-home-link">Blog Home &rarr;</a>
          </div>

          <div class="cached-grid">
            {
              cachedSamplePosts.map((post) => (
                <a href={`/${post.id}`} class="cached-card">
                  <div class="cached-card-body">
                    <h4 class="cached-post-title">{post.data.title}</h4>
                    <p class="cached-post-desc">{post.data.description}</p>
                    <div class="cached-meta">
                      <span class="cached-date">
                        <FormattedDate date={post.data.pubDate} />
                      </span>
                      <span class="cached-badge-pill">Cached offline</span>
                    </div>
                  </div>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </main>

    <Footer />
  </body>
</html>

<style>
  .offline-main {
    min-height: 90vh;
    padding: 2rem 1rem 5rem;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .offline-container {
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .offline-glow {
    position: fixed;
    top: 15%;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 350px;
    background: radial-gradient(
      circle,
      rgba(234, 179, 8, 0.08) 0%,
      rgba(59, 130, 246, 0.04) 50%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
    filter: blur(60px);
  }

  /* Header */
  .offline-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding-bottom: 1.25rem;
    border-bottom: 1px dashed var(--border-subtle);
  }

  .offline-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--text-primary);
  }

  .offline-logo {
    width: 32px;
    height: 32px;
    object-fit: contain;
    transition: transform 0.2s ease;
  }

  .offline-brand:hover .offline-logo {
    transform: scale(1.08);
  }

  .offline-brand-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }

  .offline-nav-actions {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .offline-nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    background: transparent;
    transition: all 0.15s ease;
    text-decoration: none;
  }

  .offline-nav-btn:hover {
    color: var(--text-primary);
    background: var(--bg-hover);
    border-color: var(--border-hover);
  }

  /* Status Banner */
  .offline-status-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 1rem;
    background: rgba(234, 179, 8, 0.08);
    border: 1px solid rgba(234, 179, 8, 0.25);
    border-radius: 10px;
    font-family: var(--font-mono);
  }

  .status-left {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .offline-pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #eab308;
    box-shadow: 0 0 10px #eab308;
    animation: offline-pulse 1.8s infinite;
  }

  @keyframes offline-pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.4;
      transform: scale(0.85);
    }
  }

  .status-title {
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #eab308;
  }

  .status-retry-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--text-primary);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .status-retry-btn:hover {
    border-color: var(--border-hover);
    background: var(--bg-hover);
  }

  /* ── 🕹️ GAME WRAPPER ── */
  .game-wrapper {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
    display: flex;
    flex-direction: column;
  }

  .game-header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.25rem;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-subtle);
  }

  .game-title-group {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .game-badge {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    background: rgba(59, 130, 246, 0.15);
    color: var(--accent-primary, #60a5fa);
    border: 1px solid rgba(59, 130, 246, 0.3);
  }

  .game-title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: var(--text-primary);
    margin: 0;
  }

  .game-stats-bar {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-family: var(--font-mono);
  }

  .stat-item {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    font-size: 0.76rem;
    color: var(--text-muted);
  }

  .stat-item.active .stat-value {
    color: var(--accent-primary, #60a5fa);
    font-weight: 700;
  }

  .stat-label {
    font-size: 0.68rem;
    font-weight: 600;
    opacity: 0.8;
  }

  .stat-value {
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .sound-toggle-btn {
    background: transparent;
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    width: 28px;
    height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 0.85rem;
    transition: all 0.15s ease;
  }

  .sound-toggle-btn:hover {
    background: var(--bg-hover);
  }

  /* Canvas frame */
  .canvas-frame {
    position: relative;
    width: 100%;
    height: 240px;
    background: #090a0f;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    touch-action: manipulation;
  }

  #runner-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Overlay */
  .game-overlay {
    position: absolute;
    inset: 0;
    background: rgba(9, 10, 15, 0.88);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    text-align: center;
    transition: opacity 0.2s ease;
  }

  .game-overlay.hidden {
    opacity: 0;
    pointer-events: none;
  }

  .overlay-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 420px;
  }

  .overlay-icon {
    font-size: 2rem;
    margin-bottom: 0.25rem;
    filter: drop-shadow(0 0 12px #eab308);
  }

  .overlay-title {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 900;
    color: #fff;
    margin: 0 0 0.4rem;
    letter-spacing: -0.01em;
  }

  .overlay-subtitle {
    font-size: 0.84rem;
    color: #a1a1aa;
    margin: 0 0 1rem;
    line-height: 1.45;
  }

  .overlay-keys {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: #71717a;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .key-pill {
    background: #27272a;
    border: 1px solid #3f3f46;
    color: #e4e4e7;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    font-weight: 700;
  }

  .play-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.65rem 1.75rem;
    background: #3b82f6;
    color: #fff;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    box-shadow: 0 0 20px rgba(59, 130, 246, 0.4);
    transition: all 0.15s ease;
  }

  .play-btn:hover {
    background: #2563eb;
    transform: scale(1.04);
    box-shadow: 0 0 25px rgba(59, 130, 246, 0.6);
  }

  /* Mobile Controls */
  .mobile-controls-row {
    padding: 0.75rem 1rem;
    background: var(--bg-secondary);
    border-top: 1px solid var(--border-subtle);
    display: flex;
    justify-content: center;
  }

  .mobile-action-btn {
    width: 100%;
    max-width: 320px;
    padding: 0.75rem;
    background: var(--bg-card);
    border: 1px solid var(--border-glow, var(--border-subtle));
    border-radius: 10px;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.84rem;
    letter-spacing: 0.05em;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    transition: all 0.15s ease;
  }

  .mobile-action-btn:active {
    background: var(--accent-primary, #3b82f6);
    color: #fff;
    transform: scale(0.98);
  }

  /* ── CACHED ARTICLES SECTION ── */
  .cached-section {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-top: 0.5rem;
  }

  .cached-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cached-header-left {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--text-muted);
  }

  .cached-title {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin: 0;
  }

  .cached-home-link {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--accent-primary, #60a5fa);
    text-decoration: none;
    font-weight: 600;
    transition: opacity 0.15s ease;
  }

  .cached-home-link:hover {
    opacity: 0.8;
  }

  .cached-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  @media (min-width: 640px) {
    .cached-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .cached-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    padding: 0.95rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .cached-card:hover {
    border-color: var(--border-hover);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }

  .cached-card-body {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .cached-post-title {
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--text-primary);
    margin: 0 0 0.35rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cached-post-desc {
    font-size: 0.76rem;
    line-height: 1.45;
    color: var(--text-muted);
    margin: 0 0 0.75rem;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cached-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-muted);
    padding-top: 0.45rem;
    border-top: 1px dashed var(--border-subtle);
  }

  .cached-badge-pill {
    color: #22c55e;
    font-weight: 600;
  }
</style>

<script is:inline>
  // ── BYTE RUNNER ENGINE (Web Audio + Canvas 60fps) ──
  (function initByteRunner() {
    const canvas = document.getElementById("runner-canvas");
    const container = document.getElementById("canvas-container");
    const overlay = document.getElementById("game-overlay");
    const overlayTitle = document.getElementById("overlay-title");
    const overlaySubtitle = document.getElementById("overlay-subtitle");
    const startPlayBtn = document.getElementById("start-play-btn");
    const mobileJumpBtn = document.getElementById("mobile-jump-btn");
    const scoreEl = document.getElementById("game-score");
    const highscoreEl = document.getElementById("game-highscore");
    const soundToggle = document.getElementById("game-sound-toggle");
    const soundIcon = document.getElementById("sound-icon");
    const reconnectBtn = document.getElementById("check-connection-btn");

    if (!canvas) return;
    const ctx = canvas.getContext("2d");

    // High score from localStorage
    let highScore = parseInt(
      localStorage.getItem("priyam_runner_highscore") || "0",
      10,
    );
    highscoreEl.textContent = highScore.toString().padStart(4, "0");

    // Sound FX with Web Audio API Synthesizer
    let soundEnabled = true;
    let audioCtx = null;

    function getAudioContext() {
      if (!audioCtx) {
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        if (AudioContext) audioCtx = new AudioContext();
      }
      if (audioCtx && audioCtx.state === "suspended") {
        audioCtx.resume();
      }
      return audioCtx;
    }

    function playTone(freq, type, duration, gainVal = 0.15) {
      if (!soundEnabled) return;
      try {
        const actx = getAudioContext();
        if (!actx) return;
        const osc = actx.createOscillator();
        const gain = actx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, actx.currentTime);
        gain.gain.setValueAtTime(gainVal, actx.currentTime);
        gain.gain.exponentialRampToValueAtTime(
          0.001,
          actx.currentTime + duration,
        );
        osc.connect(gain);
        gain.connect(actx.destination);
        osc.start();
        osc.stop(actx.currentTime + duration);
      } catch (e) {}
    }

    function soundJump() {
      playTone(340, "square", 0.12, 0.1);
    }
    function soundDoubleJump() {
      playTone(540, "sine", 0.15, 0.12);
    }
    function soundCoin() {
      playTone(587.33, "sine", 0.08, 0.15);
      setTimeout(() => playTone(880, "sine", 0.12, 0.15), 60);
    }
    function soundCrash() {
      if (!soundEnabled) return;
      try {
        const actx = getAudioContext();
        if (!actx) return;
        const osc = actx.createOscillator();
        const gain = actx.createGain();
        osc.type = "sawtooth";
        osc.frequency.setValueAtTime(140, actx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(30, actx.currentTime + 0.35);
        gain.gain.setValueAtTime(0.2, actx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, actx.currentTime + 0.35);
        osc.connect(gain);
        gain.connect(actx.destination);
        osc.start();
        osc.stop(actx.currentTime + 0.35);
      } catch (e) {}
    }

    if (soundToggle && soundIcon) {
      soundToggle.addEventListener("click", (e) => {
        e.stopPropagation();
        soundEnabled = !soundEnabled;
        soundIcon.textContent = soundEnabled ? "🔊" : "🔇";
      });
    }

    // Canvas scaling for sharp retina rendering
    let width = 680;
    let height = 240;

    function resizeCanvas() {
      const rect = container.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = rect.width;
      height = rect.height;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx.scale(dpr, dpr);
    }
    window.addEventListener("resize", resizeCanvas);
    resizeCanvas();

    // Game state
    let state = "IDLE"; // IDLE, PLAYING, GAMEOVER
    let score = 0;
    let speed = 4.5;
    let distance = 0;
    let lastTime = 0;
    let groundY = height - 36;

    // Player (Cyber Bot)
    const player = {
      x: 50,
      y: 0,
      w: 24,
      h: 30,
      vy: 0,
      gravity: 0.65,
      jumpForce: -10.5,
      isGrounded: false,
      jumpsRemaining: 2,
      legAngle: 0,
      particles: [],
      reset() {
        this.x = 50;
        this.y = groundY - this.h;
        this.vy = 0;
        this.isGrounded = true;
        this.jumpsRemaining = 2;
        this.particles = [];
      },
      jump() {
        if (this.jumpsRemaining > 0) {
          if (this.jumpsRemaining === 2) {
            soundJump();
          } else {
            soundDoubleJump();
            // Thruster particle burst
            for (let i = 0; i < 8; i++) {
              this.particles.push({
                x: this.x + this.w / 2,
                y: this.y + this.h,
                vx: (Math.random() - 0.5) * 4,
                vy: Math.random() * 3 + 2,
                color: "#60a5fa",
                alpha: 1,
                size: Math.random() * 3 + 2,
              });
            }
          }
          this.vy = this.jumpForce;
          this.isGrounded = false;
          this.jumpsRemaining--;
        }
      },
      update() {
        this.vy += this.gravity;
        this.y += this.vy;

        if (this.y >= groundY - this.h) {
          this.y = groundY - this.h;
          this.vy = 0;
          this.isGrounded = true;
          this.jumpsRemaining = 2;
        }

        if (this.isGrounded) {
          this.legAngle += 0.25;
        }

        // Update particles
        for (let i = this.particles.length - 1; i >= 0; i--) {
          const p = this.particles[i];
          p.x += p.vx;
          p.y += p.vy;
          p.alpha -= 0.04;
          if (p.alpha <= 0) this.particles.splice(i, 1);
        }
      },
      draw() {
        // Draw particles
        this.particles.forEach((p) => {
          ctx.save();
          ctx.globalAlpha = Math.max(0, p.alpha);
          ctx.fillStyle = p.color;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
          ctx.fill();
          ctx.restore();
        });

        // Bot Body
        ctx.save();
        ctx.fillStyle = "#60a5fa";
        ctx.strokeStyle = "#93c5fd";
        ctx.lineWidth = 1.5;

        // Head with visor
        ctx.fillRect(this.x + 4, this.y, 16, 12);
        ctx.strokeRect(this.x + 4, this.y, 16, 12);

        // Visor glow
        ctx.fillStyle = "#facc15";
        ctx.fillRect(this.x + 12, this.y + 3, 7, 4);

        // Torso
        ctx.fillStyle = "#3b82f6";
        ctx.fillRect(this.x + 2, this.y + 13, 20, 10);
        ctx.strokeRect(this.x + 2, this.y + 13, 20, 10);

        // Legs (animated running)
        ctx.fillStyle = "#93c5fd";
        if (this.isGrounded) {
          const legOff1 = Math.sin(this.legAngle) * 5;
          const legOff2 = -legOff1;
          ctx.fillRect(this.x + 5, this.y + 23, 4, 7 + legOff1);
          ctx.fillRect(this.x + 15, this.y + 23, 4, 7 + legOff2);
        } else {
          // Jump pose
          ctx.fillRect(this.x + 4, this.y + 22, 5, 5);
          ctx.fillRect(this.x + 15, this.y + 21, 5, 4);
        }
        ctx.restore();
      },
    };

    // Obstacles & Pickups
    let obstacles = [];
    let coins = [];
    let explosionParticles = [];
    let stars = [];

    // Background Stars & Grid
    for (let i = 0; i < 40; i++) {
      stars.push({
        x: Math.random() * width,
        y: Math.random() * (groundY - 30),
        size: Math.random() * 1.5 + 0.5,
        speed: Math.random() * 0.5 + 0.2,
      });
    }

    function spawnObstacle() {
      const type = Math.random() > 0.4 ? "barrier" : "drone";
      if (type === "barrier") {
        const heightVariants = [24, 32, 40];
        const h =
          heightVariants[Math.floor(Math.random() * heightVariants.length)];
        obstacles.push({
          type: "barrier",
          x: width + 30,
          y: groundY - h,
          w: 18,
          h: h,
          color: "#ef4444",
          label: "404",
        });
      } else {
        // Floating glitch drone
        obstacles.push({
          type: "drone",
          x: width + 30,
          y: groundY - 45 - Math.random() * 25,
          w: 22,
          h: 16,
          color: "#f97316",
          wingAngle: 0,
        });
      }

      // Chance to spawn an energy byte coin nearby
      if (Math.random() > 0.5) {
        coins.push({
          x: width + 100,
          y: groundY - 35 - Math.random() * 30,
          w: 14,
          h: 14,
          collected: false,
        });
      }
    }

    let spawnTimer = 0;
    let nextSpawnTime = 90;

    function resetGame() {
      score = 0;
      distance = 0;
      speed = 4.5;
      obstacles = [];
      coins = [];
      explosionParticles = [];
      spawnTimer = 0;
      nextSpawnTime = 80;
      player.reset();
      scoreEl.textContent = "0000";
    }

    function createExplosion(x, y, color = "#ef4444") {
      for (let i = 0; i < 24; i++) {
        const angle = Math.random() * Math.PI * 2;
        const vel = Math.random() * 6 + 1.5;
        explosionParticles.push({
          x,
          y,
          vx: Math.cos(angle) * vel,
          vy: Math.sin(angle) * vel,
          size: Math.random() * 4 + 2,
          color,
          alpha: 1,
        });
      }
    }

    function gameOver() {
      state = "GAMEOVER";
      soundCrash();
      createExplosion(player.x + player.w / 2, player.y + player.h / 2);

      if (score > highScore) {
        highScore = score;
        localStorage.setItem("priyam_runner_highscore", String(highScore));
        highscoreEl.textContent = highScore.toString().padStart(4, "0");
        overlayTitle.textContent = "🎉 NEW HIGH SCORE!";
      } else {
        overlayTitle.textContent = "GAME OVER";
      }

      overlaySubtitle.textContent = `You scored ${score} points!`;
      startPlayBtn.innerHTML = "<span>PLAY AGAIN</span>";
      overlay.classList.remove("hidden");
    }

    function handleJumpAction() {
      getAudioContext();
      if (state === "IDLE" || state === "GAMEOVER") {
        resetGame();
        state = "PLAYING";
        overlay.classList.add("hidden");
        player.jump();
      } else if (state === "PLAYING") {
        player.jump();
      }
    }

    // Controls
    window.addEventListener("keydown", (e) => {
      if (e.code === "Space" || e.code === "ArrowUp" || e.code === "KeyW") {
        // Prevent page scroll
        if (e.target === document.body || e.target === canvas) {
          e.preventDefault();
        }
        handleJumpAction();
      }
    });

    container.addEventListener("pointerdown", (e) => {
      e.preventDefault();
      handleJumpAction();
    });

    if (startPlayBtn) {
      startPlayBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        handleJumpAction();
      });
    }

    if (mobileJumpBtn) {
      mobileJumpBtn.addEventListener("pointerdown", (e) => {
        e.preventDefault();
        e.stopPropagation();
        handleJumpAction();
      });
    }

    if (reconnectBtn) {
      reconnectBtn.addEventListener("click", () => {
        reconnectBtn.textContent = "Checking...";
        setTimeout(() => {
          if (navigator.onLine) {
            window.location.href = "/";
          } else {
            window.location.reload();
          }
        }, 300);
      });
    }

    // Auto-reload when back online
    window.addEventListener("online", () => {
      window.location.href = "/";
    });

    // Main Game Loop
    function gameLoop(time) {
      requestAnimationFrame(gameLoop);
      groundY = height - 32;

      // Clear Canvas
      ctx.fillStyle = "#090a0f";
      ctx.fillRect(0, 0, width, height);

      // 1. Draw Starfield
      ctx.fillStyle = "rgba(255, 255, 255, 0.4)";
      stars.forEach((s) => {
        if (state === "PLAYING") {
          s.x -= s.speed;
          if (s.x < 0) s.x = width;
        }
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.size, 0, Math.PI * 2);
        ctx.fill();
      });

      // 2. Draw Cyber Floor Grid
      ctx.strokeStyle = "rgba(59, 130, 246, 0.35)";
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(0, groundY);
      ctx.lineTo(width, groundY);
      ctx.stroke();

      // Moving floor ticks
      if (state === "PLAYING") distance += speed;
      ctx.strokeStyle = "rgba(59, 130, 246, 0.2)";
      const tickSpacing = 28;
      const offset = distance % tickSpacing;
      for (let x = -offset; x < width; x += tickSpacing) {
        ctx.beginPath();
        ctx.moveTo(x, groundY);
        ctx.lineTo(x - 12, height);
        ctx.stroke();
      }

      // 3. Update & Draw Player
      if (state === "PLAYING") {
        player.update();
        score += 1;
        scoreEl.textContent = score.toString().padStart(4, "0");

        // Gradually speed up
        speed = 4.5 + Math.min(score / 500, 4.5);

        // Spawn obstacles
        spawnTimer++;
        if (spawnTimer >= nextSpawnTime) {
          spawnObstacle();
          spawnTimer = 0;
          nextSpawnTime =
            Math.floor(Math.random() * 45) + 65 - Math.min(score / 80, 25);
        }
      }

      player.draw();

      // 4. Update & Draw Obstacles
      for (let i = obstacles.length - 1; i >= 0; i--) {
        const obs = obstacles[i];
        if (state === "PLAYING") obs.x -= speed;

        // Draw Obstacle
        if (obs.type === "barrier") {
          ctx.save();
          ctx.fillStyle = obs.color;
          ctx.shadowColor = obs.color;
          ctx.shadowBlur = 8;
          ctx.fillRect(obs.x, obs.y, obs.w, obs.h);
          ctx.strokeStyle = "#fca5a5";
          ctx.strokeRect(obs.x, obs.y, obs.w, obs.h);

          // 404 Label
          ctx.fillStyle = "#fff";
          ctx.font = "bold 8px monospace";
          ctx.fillText(obs.label, obs.x + 1, obs.y + 12);
          ctx.restore();
        } else {
          // Drone
          obs.wingAngle = (obs.wingAngle || 0) + 0.3;
          ctx.save();
          ctx.fillStyle = obs.color;
          ctx.shadowColor = obs.color;
          ctx.shadowBlur = 6;
          ctx.fillRect(obs.x, obs.y, obs.w, obs.h);
          // Wings
          ctx.strokeStyle = "#fdba74";
          const wingY = Math.sin(obs.wingAngle) * 4;
          ctx.beginPath();
          ctx.moveTo(obs.x - 4, obs.y + 8 + wingY);
          ctx.lineTo(obs.x + obs.w + 4, obs.y + 8 - wingY);
          ctx.stroke();
          ctx.restore();
        }

        // Collision Check (AABB with padding)
        const pad = 4;
        if (
          state === "PLAYING" &&
          player.x + pad < obs.x + obs.w &&
          player.x + player.w - pad > obs.x &&
          player.y + pad < obs.y + obs.h &&
          player.y + player.h - pad > obs.y
        ) {
          gameOver();
        }

        if (obs.x + obs.w < -20) {
          obstacles.splice(i, 1);
        }
      }

      // 5. Update & Draw Energy Byte Coins
      for (let i = coins.length - 1; i >= 0; i--) {
        const c = coins[i];
        if (state === "PLAYING") c.x -= speed;

        // Coin pulse glow
        ctx.save();
        ctx.fillStyle = "#eab308";
        ctx.shadowColor = "#eab308";
        ctx.shadowBlur = 10;
        ctx.beginPath();
        ctx.arc(c.x + c.w / 2, c.y + c.h / 2, c.w / 2, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = "#fff";
        ctx.font = "bold 9px monospace";
        ctx.fillText("B", c.x + 4, c.y + 10);
        ctx.restore();

        // Pickup collision
        if (
          state === "PLAYING" &&
          player.x < c.x + c.w &&
          player.x + player.w > c.x &&
          player.y < c.y + c.h &&
          player.y + player.h > c.y
        ) {
          soundCoin();
          score += 100;
          createExplosion(c.x, c.y, "#eab308");
          coins.splice(i, 1);
          continue;
        }

        if (c.x + c.w < -20) {
          coins.splice(i, 1);
        }
      }

      // 6. Draw Explosion Particles
      for (let i = explosionParticles.length - 1; i >= 0; i--) {
        const p = explosionParticles[i];
        p.x += p.vx;
        p.y += p.vy;
        p.alpha -= 0.03;
        if (p.alpha <= 0) {
          explosionParticles.splice(i, 1);
          continue;
        }
        ctx.save();
        ctx.globalAlpha = Math.max(0, p.alpha);
        ctx.fillStyle = p.color;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      }
    }

    requestAnimationFrame(gameLoop);
  })();
</script>
